(load "git@github.com:carpentry-org/carp-reader@0.4.1")

(doc Diagnostic "is a single lint finding: the rule that fired, a
human-readable message, the source text of the offending form, and
the form's start `line` and `col` as captured by the parser.")
(deftype Diagnostic [rule String
                     message String
                     context String
                     line Int
                     col Int])

(defmodule Diagnostic
  (doc str "renders a diagnostic as `line:col: [rule] message`
followed by an indented `at:` line with the offending form's text.")
  (defn str [d] (fmt "%d:%d: [%s] %s
  at: %s" @(Diagnostic.line d) @(Diagnostic.col d) (Diagnostic.rule d) (Diagnostic.message d) (Diagnostic.context d)))
  (implements str Diagnostic.str))

(doc Rule "is a named, described lint rule. `fn` takes a `Located`
node and returns `(Maybe Diagnostic)`. Most rules fire on at most one
node shape; if you need to emit several diagnostics per node, split
into multiple rules.")
(deftype Rule
  [name String
   description String
   fn (Fn [(Ref Located)] (Maybe Diagnostic))])

(doc Fix "is a mechanical rewrite: replace the bytes in `[start, end)`
of the source that was linted with `replacement`. Every byte outside
that range is left alone, so formatting, comments and string escapes
elsewhere in the file survive untouched.")
(deftype Fix [start Int
              end Int
              replacement String])

(doc FixRule "is the rewrite half of a rule, kept in a registry of its
own so `Rule` stays as it is. `fn` takes the offending node and the
full source and returns `(Maybe Fix)`; `Nothing` means “no rewrite I
am sure of”, and the finding is then reported but not fixed.")
(deftype FixRule [name String
                  fn (Fn [(Ref Located) (Ref String)] (Maybe Fix))])

(doc FileRule "is a rule over a whole source file rather than a single
node. `fn` gets every top-level form and returns one `Diagnostic` per
finding, so it can tell a form's nesting depth and can let one part of
a file decide whether another part is reported.")
(deftype FileRule
  [name String
   fn (Fn [(Ref (Array (Box Located)))] (Array Diagnostic))])

(doc Suppression "is one inline `; angler-disable-…` directive. `rules`
are the rule names it covers, empty meaning all of them; `target` is
the line it applies to, `-1` for the whole file and `-2` for a comment
that opens like a directive but names none; `line`, `col` and `pos` are
the comment's own position, and `text` its bytes after the `;`.")
(deftype Suppression
  [rules (Array String)
   target Int
   line Int
   col Int
   pos Int
   text String])

(doc Lint "is the linter's core: the rule registry, the AST walker, and the
public entry points (`lint`, `lint-with`, `lint-source`,
`lint-source-with`). Plugin authors interact with it via
`register-rule!` for a rule over one node and `register-file-rule!` for
one over a whole file, and `mark-opt-in!` for a rule that should run
only when it is asked for.")
(defmodule Lint
  (private *rules*)
  (hidden *rules*)
  (def *rules* (the (Array Rule) []))

  (doc register-rule! "registers a rule under `name` with a one-line
`description`. Subsequent runs of `Lint.lint` / `Lint.lint-source`
include it. Built-ins call this at load time; plugins do the same
after loading angler.

Caveat: Carp initializes global `def`s in dependency-graph order,
not in textual or load order. If your plugin uses a top-level `def`
to call `register-rule!`, its slot in the registry — and therefore
its slot in the diagnostic output for any one form — is unspecified
relative to angler's built-ins. Rule firing is still correct;
only the order of diagnostics on a single node varies. If you need
strict ordering, register from `main` instead of from a top-level
`def`.")
  (defn register-rule! [name description fn]
    (set! *rules* (Array.push-back @&*rules* (Rule.init name description fn))))

  (private *file-rules*)
  (hidden *file-rules*)
  (def *file-rules* (the (Array FileRule) []))

  (doc register-file-rule! "registers a whole-file rule under `name`
with a one-line `description`. `f` gets the file's top-level forms and
returns every finding it has; use it for what a `Rule` cannot see from
one node — whether a form sits at top level, or whether something
written elsewhere in the file exempts it.

A file rule lists under `list-rules`, answers to `--only` and
`--disable`, and honours inline `; angler-disable-…` directives, all
like a node rule. It cannot carry a `--fix`. It is on by default like a
node rule; pair it with `mark-opt-in!` if it should not be. The
`register-rule!` caveat about top-level `def` ordering applies here
too.")
  (defn register-file-rule! [name description f]
    (do
      (register-rule! @&name description (fn [_] (Maybe.Nothing)))
      (set! *file-rules* (Array.push-back @&*file-rules* (FileRule.init name f)))))

  (doc list-rules "returns a copy of the currently registered rule
registry, file rules included. Useful for `angler --list-rules` and
for plugins that want to inspect the active rule set.")
  (defn list-rules [] @&*rules*)

  (doc nth-form "pulls the `Form` out of the i-th `Located` child of
an `Array (Box Located)`. Most rules want the structural shape, not
the position, when descending into a compound form's children.")
  (defn nth-form [items i] (Located.form (Box.peek (Array.unsafe-nth items i))))

  (doc nth-located "returns the i-th `Located` child of an `Array (Box
Located)`. Use it over `nth-form` when a rule or fix needs the child's
source position as well as its shape.")
  (defn nth-located [items i] (Box.peek (Array.unsafe-nth items i)))

  (doc sym? "true iff `f` is a `Form.Sym` whose dotted name equals
`name`. `name` may itself contain `.` to match a multi-segment
symbol — e.g. `(sym? f \"Parser.try\")` matches `Parser.try`.")
  (defn sym? [f name]
    (match-ref f
      (Form.Sym segs) (let [joined (String.join "." segs)] (= name &joined))
      _ false))

  (doc lst-head? "true iff `f` is `(Form.Lst …)` whose first child is
a `Form.Sym` matching `name`.")
  (defn lst-head? [f name]
    (match-ref f
      (Form.Lst items)
        (and (Int.> (Array.length items) 0) (sym? (nth-form items 0) name))
      _ false))

  (private kebab-case?)
  (hidden kebab-case?)
  (defn kebab-case? [name]
    (let-do [ok true]
      (for [i 0 (String.length name)]
        (let [c (String.char-at name i)]
          (when (and (Char.>= c \A) (Char.<= c \Z)) (set! ok false))))
      ok))

  (private pascal-case?)
  (hidden pascal-case?)
  (defn pascal-case? [name]
    (let-do [n (String.length name)
             ok true]
      (if (Int.= 0 n)
        false
        (do
          (let [c0 (String.char-at name 0)]
            (unless (and (Char.>= c0 \A) (Char.<= c0 \Z)) (set! ok false)))
          (for [i 1 n]
            (let [c (String.char-at name i)]
              (when (or (Char.= c \-) (Char.= c \_)) (set! ok false))))
          ok))))

  (private not-arg?)
  (hidden not-arg?)
  (defn not-arg? [f]
    (match-ref f
      (Form.Lst items)
        (and (Int.= 2 (Array.length items)) (sym? (nth-form items 0) "not"))
      _ false))

  (private dx)
  (hidden dx)
  (defn dx [info rule msg ctx]
    (Maybe.Just
      (Diagnostic.init @rule @msg ctx @(Info.line info) @(Info.col info))))

  (private empty-list?)
  (hidden empty-list?)
  (defn empty-list? [f]
    (match-ref f (Form.Lst items) (Int.= 0 (Array.length items)) _ false))

  (private form-with-do-variant)
  (hidden form-with-do-variant)
  (defn form-with-do-variant [name]
    (cond
      (= name "let") (Maybe.Just @"let-do")
      (= name "while") (Maybe.Just @"while-do")
      (= name "when") (Maybe.Just @"when-do")
      (= name "unless") (Maybe.Just @"unless-do")
      (Maybe.Nothing)))

  (private name-byte?)
  (hidden name-byte?)
  (defn name-byte? [c]
    (or
      (or (and (Char.>= c \a) (Char.<= c \z))
          (and (Char.>= c \A) (Char.<= c \Z)))
      (or (and (Char.>= c \0) (Char.<= c \9)) (or (Char.= c \-) (Char.= c \_)))))

  (private starts-with-bytes?)
  (hidden starts-with-bytes?)
  ; core's starts-with? guards on byte length but slices characters
  (defn starts-with-bytes? [s sub]
    (let [n (String.length sub)]
      (and (Int.>= (String.length s) n) (= sub &(String.byte-slice s 0 n)))))

  (private all-name-bytes?)
  (hidden all-name-bytes?)
  (defn all-name-bytes? [s]
    (let-do [n (String.length s)
             i 1]
      (while (and (Int.< i n) (name-byte? (String.char-at s i)))
        (set! i (Int.inc i)))
      (Int.= i n)))

  (private metavar?)
  (hidden metavar?)
  (defn metavar? [segs]
    (and (Int.= 1 (Array.length segs))
         (let [s (Array.unsafe-nth segs 0)]
           (and (Int.> (String.length s) 1)
                (and (Char.= \? (String.char-at s 0)) (all-name-bytes? s))))))

  (private lookup-binding)
  (hidden lookup-binding)
  (defn lookup-binding [bindings name]
    (let-do [result (Maybe.Nothing)
             n (Array.length bindings)]
      (for [i 0 n]
        (let [p (Array.unsafe-nth bindings i)]
          (when (= (Pair.a p) name) (set! result (Maybe.Just @(Pair.b p))))))
      result))

  (private no-bindings)
  (hidden no-bindings)
  (defn no-bindings [] (the (Array (Pair String Located)) []))

  (private match-pattern)
  (hidden match-pattern)
  (defn match-pattern [pat l bindings]
    (let [form (Located.form l)]
      (match-ref pat
        (Form.Sym segs)
          (cond
            (metavar? segs)
              (let [name @(Array.unsafe-nth segs 0)]
                (match (lookup-binding &bindings &name)
                  (Maybe.Just bound)
                    (if (= &(Form.str (Located.form &bound)) &(Form.str form))
                      (Maybe.Just bindings)
                      (Maybe.Nothing))
                  (Maybe.Nothing)
                    (Maybe.Just (Array.push-back bindings (Pair.init name @l)))))
            (= &(Form.str pat) &(Form.str form)) (Maybe.Just bindings)
            (Maybe.Nothing))
        (Form.Lst pat-items)
          (match-ref form
            (Form.Lst form-items)
              (let [n (Array.length pat-items)]
                (if (/= n (Array.length form-items))
                  (Maybe.Nothing)
                  (let-do [result (Maybe.Just bindings)]
                    (for [i 0 n]
                      (set! result
                            (match result
                              (Maybe.Just bs)
                                (match-pattern (nth-form pat-items i)
                                               (nth-located form-items i)
                                               bs)
                              (Maybe.Nothing) (Maybe.Nothing))))
                    result)))
            _ (Maybe.Nothing))
        _
          (if (= &(Form.str pat) &(Form.str form))
            (Maybe.Just bindings)
            (Maybe.Nothing)))))

  (private register-pattern-form-rule!)
  (hidden register-pattern-form-rule!)
  (defn register-pattern-form-rule! [name description pat message]
    (let [rn @&name
          msg @&message]
      (register-rule! name
                      description
                      (fn [l]
                        (let [f (Located.form l)
                              info (Located.info l)]
                          (match (match-pattern &pat l (no-bindings))
                            (Maybe.Just _) (dx info &rn &msg (Form.str f))
                            (Maybe.Nothing) (Maybe.Nothing)))))))

  (doc register-pattern-rule! "registers a lint rule that fires when
`pattern-str` (a single Carp form) structurally matches a node.
Symbols starting with `?` followed by one or more name characters and
nothing else are metavariables: they match any form, and if the same
`?name` appears more than once the bound forms must have equal string
representations. Any other symbol starting with `?` is an ordinary
symbol and matches literally.

```
(Lint.register-pattern-rule! @\"set-self\"
                             @\"(set! x x) is a no-op\"
                             \"(set! ?x ?x)\"
                             @\"(set! x x) is a no-op\")
```")
  (defn register-pattern-rule! [name description pattern-str message]
    (match (Reader.parse pattern-str)
      (Result.Success forms)
        (when (Int.= 1 (Array.length &forms))
          (register-pattern-form-rule! name
                                       description
                                       @(Located.form (Box.peek (Array.unsafe-nth &forms
                                                                                  0)))
                                       message))
      (Result.Error _) ()))

  (private *fixes*)
  (hidden *fixes*)
  (def *fixes* (the (Array FixRule) []))

  (doc register-fix! "registers a rewrite for the rule called `name`.
`fn` receives a node the rule fired on and the full source it came
from, and returns the `Fix` to apply, or `Nothing` if this particular
node has no rewrite that is certainly semantics-preserving.

Several fixes may share a rule name; the first one to return `Just`
wins. A rule without a fix is reported by `lint` exactly as before and
skipped by `fix-source`.")
  (defn register-fix! [name fn]
    (set! *fixes* (Array.push-back @&*fixes* (FixRule.init name fn))))

  (doc fixable? "true iff at least one fix is registered for the rule
called `name`.")
  (defn fixable? [name]
    (let-do [found false
             n (Array.length &*fixes*)]
      (for [i 0 n]
        (when (= name (FixRule.name (Array.unsafe-nth &*fixes* i)))
          (set! found true)))
      found))

  (private *opt-in*)
  (hidden *opt-in*)
  (def *opt-in* (the (Array String) []))

  (doc mark-opt-in! "marks the rule called `name` as off by default, so
it runs only when it is asked for by name. Use it for a rule whose
finding is a judgement call rather than a defect, so registering it
does not change what an existing run reports.

`lint` and `lint-source` skip an opt-in rule. `lint-with` and
`lint-source-with` run whatever their `keep?` admits — the caller is
already stating the policy — and the CLI runs an opt-in rule when
`--only` names it.")
  (defn mark-opt-in! [name] (set! *opt-in* (Array.push-back @&*opt-in* name)))

  (doc opt-in? "true iff the rule called `name` was marked off by
default with `mark-opt-in!`.")
  (defn opt-in? [name] (Array.contains? &*opt-in* name))

  (private on-by-default?)
  (hidden on-by-default?)
  (defn on-by-default? [name] (not (opt-in? name)))

  (private comment?)
  (hidden comment?)
  (defn comment? [f] (match-ref f (Form.Cmt _) true _ false))

  (private code-count)
  (hidden code-count)
  (defn code-count [items]
    (let-do [n 0]
      (for [i 0 (Array.length items)]
        (unless (comment? (nth-form items i)) (set! n (Int.inc n))))
      n))

  (private code-index)
  (hidden code-index)
  ; index of the i-th non-comment child, or -1; callers check `code-count`
  ; first, so it is always in range.
  (defn code-index [items i]
    (let-do [n (Array.length items)
             j 0
             seen 0
             at -1]
      (while-do (and (Int.< j n) (Int.< at 0))
        (unless-do (comment? (nth-form items j))
          (when (Int.= seen i) (set! at j))
          (set! seen (Int.inc seen)))
        (set! j (Int.inc j)))
      at))

  (private nth-code-form)
  (hidden nth-code-form)
  (defn nth-code-form [items i] (nth-form items (code-index items i)))

  (private nth-code-located)
  (hidden nth-code-located)
  (defn nth-code-located [items i] (nth-located items (code-index items i)))

  (private splice-node?)
  (hidden splice-node?)
  (defn splice-node? [l]
    (match-ref (Located.form l)
      (Form.Lst items)
        (and (Int.= 2 (Array.length items))
             (sym? (nth-form items 0) "unquote-splicing"))
      _ false))

  ; a synthesized node (reader-macro head) has an empty span, so this
  ; also rejects nodes that have no bytes of their own to splice.
  (private splicable?)
  (hidden splicable?)
  (defn splicable? [l src]
    (let [start @(Info.pos (Located.info l))
          end @(Info.pos (Located.end l))]
      (and (Int.< start end)
           (and (Int.<= end (String.length src))
                (not (comment? (Located.form l)))))))

  (private slice-of)
  (hidden slice-of)
  (defn slice-of [src l]
    (if (splicable? l src)
      (Maybe.Just
        (String.byte-slice src
                           @(Info.pos (Located.info l))
                           @(Info.pos (Located.end l))))
      (Maybe.Nothing)))

  (private rewrite)
  (hidden rewrite)
  (defn rewrite [l src text]
    (if (splicable? l src)
      (Maybe.Just
        (Fix.init @(Info.pos (Located.info l)) @(Info.pos (Located.end l)) text))
      (Maybe.Nothing)))

  (private replace-with)
  (hidden replace-with)
  (defn replace-with [l src inner prefix suffix]
    (if (and (Int.= 0 (String.length prefix))
             (and (Int.= 0 (String.length suffix)) (splice-node? inner)))
      (Maybe.Nothing)
      (match (slice-of src inner)
        (Maybe.Just s) (rewrite l src (String.concat &[@prefix s @suffix]))
        (Maybe.Nothing) (Maybe.Nothing))))

  (private all-splicable?)
  (hidden all-splicable?)
  (defn all-splicable? [items src]
    (let-do [ok true]
      (for [i 0 (Array.length items)]
        (unless (splicable? (nth-located items i) src) (set! ok false)))
      ok))

  (private all-code-splicable?)
  (hidden all-code-splicable?)
  (defn all-code-splicable? [items src]
    (let-do [ok true]
      (for [i 0 (code-count items)]
        (unless (splicable? (nth-code-located items i) src) (set! ok false)))
      ok))

  (private parts-in-order?)
  (hidden parts-in-order?)
  (defn parts-in-order? [parts lo hi]
    (let-do [ok true
             at lo]
      (for [i 0 (Array.length parts)]
        (let [p (Array.unsafe-nth parts i)]
          (if (and (Int.<= at @(Pair.a p)) (Int.<= @(Pair.a p) @(Pair.b p)))
            (set! at @(Pair.b p))
            (set! ok false))))
      (and ok (Int.<= at hi))))

  (private copy-parts)
  (hidden copy-parts)
  (defn copy-parts [src parts]
    (let-do [out @""]
      (for [i 0 (Array.length parts)]
        (let [p (Array.unsafe-nth parts i)]
          (set! out
                (String.append &out
                               &(String.byte-slice src @(Pair.a p) @(Pair.b p))))))
      out))

  (private head-end)
  (hidden head-end)
  ; 0 for a form that has no head token; `parts-in-order?` then rejects
  ; the rewrite, since a list's own bytes start at 1 or later.
  (defn head-end [l]
    (match-ref (Located.form l)
      (Form.Lst items)
        (if (Int.> (Array.length items) 0)
          @(Info.pos (Located.end (nth-located items 0)))
          0)
      _ 0))

  (private rebuild-parts)
  (hidden rebuild-parts)
  ; rebuilds `l` as its opening bytes, then `head` in place of its head
  ; token, then each `(Pair from to)` of `parts` copied out of `src`
  ; verbatim. Bytes outside `parts` are dropped, so a caller that keeps
  ; comment children must cover them with a part.
  (defn rebuild-parts [l src head parts]
    (match-ref (Located.form l)
      (Form.Lst items)
        (if (and (Int.> (Array.length items) 0) (splicable? l src))
          (let [from @(Info.pos (Located.info l))
                hd @(Info.pos (Located.info (nth-located items 0)))
                to @(Info.pos (Located.end l))]
            (if (and (Int.<= from hd) (parts-in-order? parts hd to))
              (rewrite l
                       src
                       (String.concat
                         &[(String.byte-slice src from hd)
                           @head
                           (copy-parts src parts)]))
              (Maybe.Nothing)))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private rebuild)
  (hidden rebuild)
  (defn rebuild [l src head parts]
    (match-ref (Located.form l)
      (Form.Lst items)
        (if (all-splicable? items src)
          (rebuild-parts l src head parts)
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private body-forms?)
  (hidden body-forms?)
  ; a body of nothing but comments would splice away to nothing.
  (defn body-forms? [items]
    (let-do [found false]
      (for [i 1 (Array.length items)]
        (unless (comment? (nth-form items i)) (set! found true)))
      found))

  (private splice-fix)
  (hidden splice-fix)
  ; rewrites `(HEAD keep inner …)` as `head`, `keep`, and `inner`'s body
  ; of arbitrary arity spliced in. Without `keep-tail?` everything
  ; between `inner` and the closing paren is dropped.
  (defn splice-fix [l src head keep inner keep-tail?]
    (match-ref (Located.form inner)
      (Form.Lst body)
        (if (and (Int.> (Array.length body) 1)
                 (and (splicable? inner src) (body-forms? body)))
          (let [ih (nth-located body 0)
                inner-end @(Info.pos (Located.end inner))
                l-end @(Info.pos (Located.end l))]
            (if (splicable? ih src)
              (rebuild l
                       src
                       head
                       &[(Pair.init (head-end l) @(Info.pos (Located.end keep)))
                         (Pair.init @(Info.pos (Located.end ih))
                                    (Int.dec inner-end))
                         (Pair.init
                           (if keep-tail? inner-end (Int.dec l-end))
                           l-end)])
              (Maybe.Nothing)))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private rehead-fix)
  (hidden rehead-fix)
  (defn rehead-fix [l src head]
    (rebuild l src head &[(Pair.init (head-end l) @(Info.pos (Located.end l)))]))

  (private drop-child-fix)
  (hidden drop-child-fix)
  (defn drop-child-fix [l src head idx]
    (match-ref (Located.form l)
      (Form.Lst items)
        (let [n (Array.length items)]
          (if (and (Int.> idx 0) (Int.< idx n))
            (let [l-end @(Info.pos (Located.end l))
                  kept-end @(Info.pos
                    (Located.end (nth-located items (Int.dec idx))))
                  after (if (Int.= idx (Int.dec n))
                    (Int.dec l-end)
                    @(Info.pos (Located.end (nth-located items idx))))]
              (rebuild l
                       src
                       head
                       &[(Pair.init (head-end l) kept-end)
                         (Pair.init after l-end)]))
            (Maybe.Nothing)))
      _ (Maybe.Nothing)))

  (private metavar-start?)
  (hidden metavar-start?)
  (defn metavar-start? [tpl i n]
    (and (Int.< (Int.inc i) n)
         (and (Char.= \? (String.char-at tpl i))
              (name-byte? (String.char-at tpl (Int.inc i))))))

  (private metavar-end)
  (hidden metavar-end)
  (defn metavar-end [tpl start n]
    (let-do [j (Int.inc start)]
      (while (and (Int.< j n) (name-byte? (String.char-at tpl j)))
        (set! j (Int.inc j)))
      j))

  (private literal-end)
  (hidden literal-end)
  (defn literal-end [tpl start n]
    (let-do [j start]
      (while (and (Int.< j n) (not (metavar-start? tpl j n)))
        (set! j (Int.inc j)))
      j))

  (private expand-template)
  (hidden expand-template)
  (defn expand-template [tpl bindings src]
    (let-do [out @""
             n (String.length tpl)
             i 0
             ok true
             lone? (and (metavar-start? tpl 0 n) (Int.= n (metavar-end tpl 0 n)))]
      (while-do (and ok (Int.< i n))
        (let-do [meta? (metavar-start? tpl i n)
                 j (if meta? (metavar-end tpl i n) (literal-end tpl i n))
                 chunk (String.byte-slice tpl i j)]
          (if meta?
            (match (lookup-binding bindings &chunk)
              (Maybe.Just bound)
                (if (and lone? (splice-node? &bound))
                  (set! ok false)
                  (match (slice-of src &bound)
                    (Maybe.Just s) (set! out (String.append &out &s))
                    (Maybe.Nothing) (set! ok false)))
              (Maybe.Nothing) (set! ok false))
            (set! out (String.append &out &chunk)))
          (set! i j)))
      (if ok (Maybe.Just out) (Maybe.Nothing))))

  (private register-pattern-fix-form!)
  (hidden register-pattern-fix-form!)
  (defn register-pattern-fix-form! [name description pat message template]
    (let-do [p @&pat]
      (register-pattern-form-rule! @&name description pat message)
      (register-fix! name
                     (fn [l src]
                       (match (match-pattern &p l (no-bindings))
                         (Maybe.Just bs)
                           (match (expand-template &template &bs src)
                             (Maybe.Just text) (rewrite l src text)
                             (Maybe.Nothing) (Maybe.Nothing))
                         (Maybe.Nothing) (Maybe.Nothing))))))

  (doc register-pattern-fix-rule! "is `register-pattern-rule!` plus a
rewrite: `template-str` is source text in which every `?name` is
replaced by the *original bytes* the metavariable matched, and the
matched node is replaced by the result. A `?` that is not followed by
a name character is literal text, so `(unless (empty? ?x) ?y)` is a
valid template.

```
(Lint.register-pattern-fix-rule! @\"double-not\"
                                 @\"(not (not x)) is just x\"
                                 \"(not (not ?x))\"
                                 @\"(not (not x)) is just x\"
                                 @\"?x\")
```

Only register a template that is unconditionally
semantics-preserving: `fix-source` applies it without asking.")
  (defn register-pattern-fix-rule! [name
                                    description
                                    pattern-str
                                    message
                                    template]
    (match (Reader.parse pattern-str)
      (Result.Success forms)
        (when (Int.= 1 (Array.length &forms))
          (register-pattern-fix-form! name
                                      description
                                      @(Located.form (Box.peek (Array.unsafe-nth &forms
                                                                                 0)))
                                      message
                                      template))
      (Result.Error _) ()))

  (private try-load-rule!)
  (hidden try-load-rule!)
  (defn try-load-rule! [f]
    (match-ref f
      (Form.Arr items)
        (let [n (Array.length items)]
          (if (or (Int.= 3 n) (Int.= 4 n))
            (match-ref (nth-form items 1)
              (Form.Str name)
                (match-ref (nth-form items 2)
                  (Form.Str msg)
                    (do
                      (if (Int.= 4 n)
                        (register-pattern-fix-form! @name
                                                    @msg
                                                    @(nth-form items 0)
                                                    @msg
                                                    (Form.str (nth-form items 3)))
                        (register-pattern-form-rule! @name
                                                     @msg
                                                     @(nth-form items 0)
                                                     @msg))
                      true)
                  _ false)
              _ false)
            false))
      _ false))

  (doc load-rules-from-source! "parses `src` as a rules file and
registers each rule found. Each top-level form must be an array
literal `[<pattern> \"name\" \"message\"]`. Symbols starting with
`?` in the pattern are metavariables, just as in
`register-pattern-rule!`. Non-conforming top-level forms are silently
skipped. Returns the number of rules loaded, or a parse error.")
  (defn load-rules-from-source! [src]
    (match (Reader.parse src)
      (Result.Success forms)
        (let-do [n (Array.length &forms)
                 loaded 0]
          (for [i 0 n]
            (let [l (Box.peek (Array.unsafe-nth &forms i))]
              (when (try-load-rule! (Located.form l))
                (set! loaded (Int.inc loaded)))))
          (Result.Success loaded))
      (Result.Error e) (Result.Error e)))

  (private rule-if-with-do)
  (hidden rule-if-with-do)
  (defn rule-if-with-do [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (and (Int.= 4 (Array.length items)) (sym? (nth-form items 0) "if"))
            (let [then-form (nth-form items 2)
                  else-form (nth-form items 3)]
              (cond
                (and (lst-head? then-form "do") (empty-list? else-form))
                  (dx info
                      "if-with-do"
                      "(if cond (do ...) ()) can be (when-do cond ...)"
                      (Form.str f))
                (and (empty-list? then-form) (lst-head? else-form "do"))
                  (dx info
                      "if-with-do"
                      "(if cond () (do ...)) can be (unless-do cond ...)"
                      (Form.str f))
                (Maybe.Nothing)))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private fix-if-with-do)
  (hidden fix-if-with-do)
  (defn fix-if-with-do [l src]
    (match-ref (Located.form l)
      (Form.Lst items)
        (if (and (Int.= 4 (Array.length items)) (sym? (nth-form items 0) "if"))
          (let [then-form (nth-form items 2)
                else-form (nth-form items 3)]
            (cond
              (and (lst-head? then-form "do") (empty-list? else-form))
                (splice-fix l
                            src
                            "when-do"
                            (nth-located items 1)
                            (nth-located items 2)
                            false)
              (and (empty-list? then-form) (lst-head? else-form "do"))
                (splice-fix l
                            src
                            "unless-do"
                            (nth-located items 1)
                            (nth-located items 3)
                            true)
              (Maybe.Nothing)))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private rule-form-with-do)
  (hidden rule-form-with-do)
  (defn rule-form-with-do [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (Int.= 3 (Array.length items))
            (let [head (nth-form items 0)
                  body (nth-form items 2)]
              (match-ref head
                (Form.Sym segs)
                  (if (and (Int.= 1 (Array.length segs)) (lst-head? body "do"))
                    (let [name (Array.unsafe-nth segs 0)
                          sugg (form-with-do-variant name)]
                      (match sugg
                        (Maybe.Just variant)
                          (dx info
                              "form-with-do"
                              &(fmt "(%s ... (do ...)) can be (%s ... ...)"
                                    name
                                    &variant)
                              (Form.str f))
                        (Maybe.Nothing) (Maybe.Nothing)))
                    (Maybe.Nothing))
                _ (Maybe.Nothing)))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private fix-form-with-do)
  (hidden fix-form-with-do)
  (defn fix-form-with-do [l src]
    (match-ref (Located.form l)
      (Form.Lst items)
        (if (Int.= 3 (Array.length items))
          (match-ref (nth-form items 0)
            (Form.Sym segs)
              (if (and (Int.= 1 (Array.length segs))
                       (lst-head? (nth-form items 2) "do"))
                (match (form-with-do-variant (Array.unsafe-nth segs 0))
                  (Maybe.Just variant)
                    (splice-fix l
                                src
                                &variant
                                (nth-located items 1)
                                (nth-located items 2)
                                true)
                  (Maybe.Nothing) (Maybe.Nothing))
                (Maybe.Nothing))
            _ (Maybe.Nothing))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private rule-try-around-atomic)
  (hidden rule-try-around-atomic)
  (defn rule-try-around-atomic [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (and (Int.= 2 (Array.length items))
                   (sym? (nth-form items 0) "Parser.try"))
            (let [arg (nth-form items 1)]
              (if (or (lst-head? arg "Parser.string")
                      (lst-head? arg "Parser.byte"))
                (dx info
                    "try-around-atomic"
                    "Parser.string / Parser.byte are atomic; the try is redundant"
                    (Form.str f))
                (Maybe.Nothing)))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private rule-non-kebab-case-defn)
  (hidden rule-non-kebab-case-defn)
  (defn rule-non-kebab-case-defn [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (Int.>= (Array.length items) 2)
            (let [head (nth-form items 0)]
              (match-ref head
                (Form.Sym hsegs)
                  (if (Int.= 1 (Array.length hsegs))
                    (let [hd (Array.unsafe-nth hsegs 0)]
                      (if (or (= hd "defn")
                              (or (= hd "defn-") (= hd "defndynamic")))
                        (let [name-form (nth-form items 1)]
                          (match-ref name-form
                            (Form.Sym segs)
                              (if (Int.= 1 (Array.length segs))
                                (let [name (Array.unsafe-nth segs 0)]
                                  (if (not (kebab-case? name))
                                    (dx info
                                        "non-kebab-case-defn"
                                        &(fmt
                                          "%s name '%s' has uppercase letters; Carp convention is kebab-case"
                                          hd
                                          name)
                                        (Form.str f))
                                    (Maybe.Nothing)))
                                (Maybe.Nothing))
                            _ (Maybe.Nothing)))
                        (Maybe.Nothing)))
                    (Maybe.Nothing))
                _ (Maybe.Nothing)))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private rule-non-pascal-case-defmodule)
  (hidden rule-non-pascal-case-defmodule)
  (defn rule-non-pascal-case-defmodule [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (and (Int.>= (Array.length items) 2)
                   (sym? (nth-form items 0) "defmodule"))
            (let [name-form (nth-form items 1)]
              (match-ref name-form
                (Form.Sym segs)
                  (if (Int.= 1 (Array.length segs))
                    (let [name (Array.unsafe-nth segs 0)]
                      (if (not (pascal-case? name))
                        (dx info
                            "non-pascal-case-defmodule"
                            &(fmt
                              "defmodule name '%s' should be PascalCase"
                              name)
                            (Form.str f))
                        (Maybe.Nothing)))
                    (Maybe.Nothing))
                _ (Maybe.Nothing)))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private rule-if-one-branch-empty)
  (hidden rule-if-one-branch-empty)
  (defn rule-if-one-branch-empty [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (and (Int.= 4 (Array.length items)) (sym? (nth-form items 0) "if"))
            (let [then-form (nth-form items 2)
                  else-form (nth-form items 3)]
              (cond
                (and (empty-list? else-form) (not (lst-head? then-form "do")))
                  (dx info
                      "if-one-branch-empty"
                      "(if cond x ()) can be (when cond x)"
                      (Form.str f))
                (and (empty-list? then-form) (not (lst-head? else-form "do")))
                  (dx info
                      "if-one-branch-empty"
                      "(if cond () x) can be (unless cond x)"
                      (Form.str f))
                (Maybe.Nothing)))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private fix-if-one-branch-empty)
  (hidden fix-if-one-branch-empty)
  (defn fix-if-one-branch-empty [l src]
    (match-ref (Located.form l)
      (Form.Lst items)
        (if (and (Int.= 4 (Array.length items)) (sym? (nth-form items 0) "if"))
          (let [then-form (nth-form items 2)
                else-form (nth-form items 3)]
            (cond
              (and (empty-list? else-form) (not (lst-head? then-form "do")))
                (drop-child-fix l src "when" 3)
              (and (empty-list? then-form) (not (lst-head? else-form "do")))
                (drop-child-fix l src "unless" 2)
              (Maybe.Nothing)))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private rule-when-do-with-not)
  (hidden rule-when-do-with-not)
  (defn rule-when-do-with-not [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (and (Int.>= (Array.length items) 3) (not-arg? (nth-form items 1)))
            (cond
              (sym? (nth-form items 0) "when-do")
                (dx info
                    "when-with-not"
                    "(when-do (not c) ...) can be (unless-do c ...)"
                    (Form.str f))
              (sym? (nth-form items 0) "unless-do")
                (dx info
                    "when-with-not"
                    "(unless-do (not c) ...) can be (when-do c ...)"
                    (Form.str f))
              (Maybe.Nothing))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private negate-head-fix)
  (hidden negate-head-fix)
  ; rewrites `(HEAD (not c) …)` as `head`, `c`, then the rest verbatim.
  (defn negate-head-fix [l src head]
    (match-ref (Located.form l)
      (Form.Lst items)
        (let [neg (nth-located items 1)]
          (match-ref (Located.form neg)
            (Form.Lst inner)
              (let [c (nth-located inner 1)]
                (if (and (splicable? c src) (not (splice-node? c)))
                  (rebuild l
                           src
                           head
                           &[(Pair.init (head-end l)
                                        @(Info.pos (Located.info neg)))
                             (Pair.init @(Info.pos (Located.info c))
                                        @(Info.pos (Located.end c)))
                             (Pair.init @(Info.pos (Located.end neg))
                                        @(Info.pos (Located.end l)))])
                  (Maybe.Nothing)))
            _ (Maybe.Nothing)))
      _ (Maybe.Nothing)))

  (private fix-when-do-with-not)
  (hidden fix-when-do-with-not)
  (defn fix-when-do-with-not [l src]
    (match-ref (Located.form l)
      (Form.Lst items)
        (if (and (Int.>= (Array.length items) 3) (not-arg? (nth-form items 1)))
          (cond
            (sym? (nth-form items 0) "when-do")
              (negate-head-fix l src "unless-do")
            (sym? (nth-form items 0) "unless-do")
              (negate-head-fix l src "when-do")
            (Maybe.Nothing))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private do-variant?)
  (hidden do-variant?)
  (defn do-variant? [name]
    (or (= name "let-do")
        (or (= name "while-do") (or (= name "when-do") (= name "unless-do")))))

  (private if-chain-comments?)
  (hidden if-chain-comments?)
  ; the rewrite copies each link from its condition to its else-branch, so
  ; only comments in that span come along.
  (defn if-chain-comments? [items]
    (let-do [ok true
             lo (code-index items 1)
             hi (code-index items 3)]
      (for [i 0 (Array.length items)]
        (when (comment? (nth-form items i))
          (unless (and (Int.< lo i) (Int.< i hi)) (set! ok false))))
      ok))

  (private if-link-shape?)
  (hidden if-link-shape?)
  (defn if-link-shape? [items]
    (and (Int.= 4 (code-count items))
         (and (sym? (nth-code-form items 0) "if") (if-chain-comments? items))))

  (private rule-nested-if-chain)
  (hidden rule-nested-if-chain)
  (defn rule-nested-if-chain [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (if-link-shape? items)
            (let [else-form (nth-code-form items 3)]
              (if (lst-head? else-form "if")
                (dx info
                    "nested-if-chain"
                    "(if c1 x (if c2 ...)) can be a cond expression"
                    (Form.str f))
                (Maybe.Nothing)))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private if-link?)
  (hidden if-link?)
  (defn if-link? [l src]
    (match-ref (Located.form l)
      (Form.Lst items)
        (and (if-link-shape? items)
             (and (splicable? l src) (all-code-splicable? items src)))
      _ false))

  (private if-chain-parts)
  (hidden if-chain-parts)
  ; one part per link, from that link's condition to the next link's
  ; opening paren; the last runs to just before its own closing paren.
  (defn if-chain-parts [l src acc]
    (match-ref (Located.form l)
      (Form.Lst items)
        (let [from @(Info.pos (Located.info (nth-code-located items 1)))
              tail (nth-code-located items 3)]
          (if (if-link? tail src)
            (if-chain-parts tail
                            src
                            (Array.push-back acc
                                             (Pair.init from
                                                        @(Info.pos (Located.info tail)))))
            (Array.push-back acc
                             (Pair.init from
                                        (Int.dec @(Info.pos (Located.end l)))))))
      _ acc))

  (private fix-nested-if-chain)
  (hidden fix-nested-if-chain)
  (defn fix-nested-if-chain [l src]
    (match-ref (Located.form l)
      (Form.Lst items)
        (if (and (if-link? l src) (if-link? (nth-code-located items 3) src))
          (let [l-end @(Info.pos (Located.end l))
                parts (if-chain-parts l src (the (Array (Pair Int Int)) []))]
            (rebuild-parts l
                           src
                           "cond "
                           &(Array.push-back parts
                                             (Pair.init (Int.dec l-end) l-end))))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private bol?)
  (hidden bol?)
  (defn bol? [f val] (match-ref f (Form.Bol b) (= b val) _ false))

  (private rule-eq-true)
  (hidden rule-eq-true)
  (defn rule-eq-true [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (and (Int.= 3 (Array.length items)) (sym? (nth-form items 0) "="))
            (let [a (nth-form items 1)
                  b (nth-form items 2)]
              (cond
                (bol? b &true)
                  (dx info "eq-true" "(= x true) is just x" (Form.str f))
                (bol? a &true)
                  (dx info "eq-true" "(= true x) is just x" (Form.str f))
                (Maybe.Nothing)))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private rule-eq-false)
  (hidden rule-eq-false)
  (defn rule-eq-false [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (and (Int.= 3 (Array.length items)) (sym? (nth-form items 0) "="))
            (let [a (nth-form items 1)
                  b (nth-form items 2)]
              (cond
                (bol? b &false)
                  (dx info "eq-false" "(= x false) is just (not x)" (Form.str f))
                (bol? a &false)
                  (dx info "eq-false" "(= false x) is just (not x)" (Form.str f))
                (Maybe.Nothing)))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private eq-bool-fix)
  (hidden eq-bool-fix)
  (defn eq-bool-fix [l src val prefix suffix]
    (match-ref (Located.form l)
      (Form.Lst items)
        (if (and (Int.= 3 (Array.length items)) (sym? (nth-form items 0) "="))
          (cond
            (bol? (nth-form items 2) val)
              (replace-with l src (nth-located items 1) prefix suffix)
            (bol? (nth-form items 1) val)
              (replace-with l src (nth-located items 2) prefix suffix)
            (Maybe.Nothing))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private fix-eq-true)
  (hidden fix-eq-true)
  (defn fix-eq-true [l src] (eq-bool-fix l src &true "" ""))

  (private fix-eq-false)
  (hidden fix-eq-false)
  (defn fix-eq-false [l src] (eq-bool-fix l src &false "(not " ")"))

  (private same-sym?)
  (hidden same-sym?)
  (defn same-sym? [a b]
    (match-ref a (Form.Sym segs) (sym? b &(String.join "." segs)) _ false))

  (private rule-eq-self)
  (hidden rule-eq-self)
  ; a call or ref on either side may be a deliberate comparison of equals
  (defn rule-eq-self [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (and (Int.= 3 (Array.length items))
                   (and (sym? (nth-form items 0) "=")
                        (same-sym? (nth-form items 1) (nth-form items 2))))
            (dx info
                "eq-self"
                "(= x x) — the variable is compared with itself"
                (Form.str f))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private rule-cond-single-branch)
  (hidden rule-cond-single-branch)
  (defn rule-cond-single-branch [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (and (Int.= 4 (Array.length items))
                   (sym? (nth-form items 0) "cond"))
            (dx info
                "cond-single-branch"
                "(cond c v default) is just (if c v default)"
                (Form.str f))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private fix-cond-single-branch)
  (hidden fix-cond-single-branch)
  (defn fix-cond-single-branch [l src]
    (match-ref (Located.form l)
      (Form.Lst items)
        (if (and (Int.= 4 (Array.length items)) (sym? (nth-form items 0) "cond"))
          (rehead-fix l src "if")
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private rule-single-use-let)
  (hidden rule-single-use-let)
  (defn rule-single-use-let [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (and (Int.= 3 (Array.length items))
                   (sym? (nth-form items 0) "let"))
            (let [bindings-form (nth-form items 1)
                  body (nth-form items 2)]
              (match-ref bindings-form
                (Form.Arr bindings)
                  (if (Int.= 2 (Array.length bindings))
                    (let [bname (nth-form bindings 0)]
                      (if (= &(Form.str bname) &(Form.str body))
                        (dx info
                            "single-use-let"
                            "(let [x expr] x) is just expr"
                            (Form.str f))
                        (Maybe.Nothing)))
                    (Maybe.Nothing))
                _ (Maybe.Nothing)))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private rule-discarded-let-body)
  (hidden rule-discarded-let-body)
  (defn rule-discarded-let-body [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (let [n (code-count items)]
            (if (and (Int.> n 3) (sym? (nth-code-form items 0) "let"))
              (match-ref (nth-code-form items 1)
                (Form.Arr _)
                  (dx info
                      "discarded-let-body"
                      &(fmt
                        "let evaluates only the first of its %d body forms; the rest are discarded"
                        (Int.- n 2))
                      (Form.str f))
                _ (Maybe.Nothing))
              (Maybe.Nothing)))
        _ (Maybe.Nothing))))

  (private fix-discarded-let-body)
  (hidden fix-discarded-let-body)
  (defn fix-discarded-let-body [l src]
    (match-ref (Located.form l)
      (Form.Lst items)
        (if (and (Int.> (code-count items) 3)
                 (sym? (nth-code-form items 0) "let"))
          (rehead-fix l src "let-do")
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private let-form-head)
  (hidden let-form-head)
  (defn let-form-head [f]
    (cond
      (sym? f "let") (Maybe.Just @"let")
      (sym? f "let-do") (Maybe.Just @"let-do")
      (Maybe.Nothing)))

  (private code-from)
  (hidden code-from)
  ; raw index of the i-th code child, or one past the end if there is none
  (defn code-from [items i]
    (if (Int.< i (code-count items)) (code-index items i) (Array.length items)))

  (private syms-occur?)
  (hidden syms-occur?)
  (defn syms-occur? [items name from]
    (let-do [found false
             i from
             n (Array.length items)]
      (while-do (and (not found) (Int.< i n))
        (match-ref (Located.form (nth-located items i))
          (Form.Sym segs) (set! found (Array.contains? segs name))
          (Form.Lst kids) (set! found (syms-occur? kids name 0))
          (Form.Arr kids) (set! found (syms-occur? kids name 0))
          (Form.StaticArr kids) (set! found (syms-occur? kids name 0))
          (Form.Dict kids) (set! found (syms-occur? kids name 0))
          _ ())
        (set! i (Int.inc i)))
      found))

  (private unquote-head?)
  (hidden unquote-head?)
  (defn unquote-head? [items]
    (and (Int.> (Array.length items) 0)
         (or (sym? (nth-form items 0) "unquote")
             (sym? (nth-form items 0) "unquote-splicing"))))

  (private unquotes-occur?)
  (hidden unquotes-occur?)
  ; a use spliced in at expansion time leaves no occurrence to find
  (defn unquotes-occur? [items from]
    (let-do [found false
             i from
             n (Array.length items)]
      (while-do (and (not found) (Int.< i n))
        (match-ref (Located.form (nth-located items i))
          (Form.Lst kids)
            (set! found (or (unquote-head? kids) (unquotes-occur? kids 0)))
          (Form.Arr kids) (set! found (unquotes-occur? kids 0))
          (Form.StaticArr kids) (set! found (unquotes-occur? kids 0))
          (Form.Dict kids) (set! found (unquotes-occur? kids 0))
          _ ())
        (set! i (Int.inc i)))
      found))

  (private discard-name?)
  (hidden discard-name?)
  ; a leading `-` marks a deliberate discard; `_` still counts, for code
  ; written before that spelling
  (defn discard-name? [s]
    (or (starts-with-bytes? s "-") (starts-with-bytes? s "_")))

  (private binding-name)
  (hidden binding-name)
  ; the name a binding or parameter form binds, or Nothing for a discard
  (defn binding-name [f]
    (match-ref f
      (Form.Sym segs)
        (if (Int.= 1 (Array.length segs))
          (let [s (Array.unsafe-nth segs 0)]
            (if (discard-name? s) (Maybe.Nothing) (Maybe.Just @s)))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private unused-bindings)
  (hidden unused-bindings)
  (defn unused-bindings [items bindings]
    (let-do [out (the (Array String) [])
             pairs (Int./ (code-count bindings) 2)
             body (code-from items 2)]
      (for [k 0 pairs]
        (let [ni (Int.* 2 k)]
          (match (binding-name (nth-code-form bindings ni))
            (Maybe.Just name)
              (unless (or
                  (syms-occur? bindings &name (code-from bindings (Int.+ ni 2)))
                  (syms-occur? items &name body))
                (set! out (Array.push-back out @&name)))
            (Maybe.Nothing) ())))
      out))

  (private name-list)
  (hidden name-list)
  (defn name-list [names]
    (let-do [out @""]
      (for [i 0 (Array.length names)]
        (do
          (when (Int.> i 0) (set! out (String.append &out ", ")))
          (set! out
                (String.append &out &(fmt "'%s'" (Array.unsafe-nth names i))))))
      out))

  (private unused-message)
  (hidden unused-message)
  (defn unused-message [head names]
    (if (Int.= 1 (Array.length names))
      (fmt "%s binding %s is never used" head &(name-list names))
      (fmt "%s bindings %s are never used" head &(name-list names))))

  (private rule-unused-let-binding)
  (hidden rule-unused-let-binding)
  (defn rule-unused-let-binding [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (and (Int.>= (code-count items) 3)
                   (not (unquotes-occur? items (code-from items 1))))
            (match (let-form-head (nth-code-form items 0))
              (Maybe.Just head)
                (match-ref (nth-code-form items 1)
                  (Form.Arr bindings)
                    (let [n (code-count bindings)]
                      (if (Int.= n (Int.* 2 (Int./ n 2)))
                        (let [unused (unused-bindings items bindings)]
                          (if (Int.= 0 (Array.length &unused))
                            (Maybe.Nothing)
                            (dx info
                                "unused-let-binding"
                                &(unused-message &head &unused)
                                (Form.str f))))
                        (Maybe.Nothing)))
                  _ (Maybe.Nothing))
              (Maybe.Nothing) (Maybe.Nothing))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private sym-occurs-in?)
  (hidden sym-occurs-in?)
  (defn sym-occurs-in? [f name]
    (match-ref f
      (Form.Sym segs) (Array.contains? segs name)
      (Form.Lst kids) (syms-occur? kids name 0)
      (Form.Arr kids) (syms-occur? kids name 0)
      (Form.StaticArr kids) (syms-occur? kids name 0)
      (Form.Dict kids) (syms-occur? kids name 0)
      _ false))

  (private shadow-index)
  (hidden shadow-index)
  ; pair index of the next binding of `name` after pair `k`, or -1
  (defn shadow-index [bindings k pairs name]
    (let-do [at -1
             j (Int.inc k)]
      (while-do (and (Int.< j pairs) (Int.< at 0))
        (match (binding-name (nth-code-form bindings (Int.* 2 j)))
          (Maybe.Just other) (when (= &other name) (set! at j))
          (Maybe.Nothing) ())
        (set! j (Int.inc j)))
      at))

  (private shadow-dead?)
  (hidden shadow-dead?)
  ; the shadowing initialiser is the last place the earlier binding can be used
  (defn shadow-dead? [bindings k j name]
    (let-do [used false
             m (Int.inc k)]
      (while-do (and (not used) (Int.<= m j))
        (set! used
              (sym-occurs-in?
                (nth-code-form bindings (Int.inc (Int.* 2 m)))
                name))
        (set! m (Int.inc m)))
      (not used)))

  (private shadowed-bindings)
  (hidden shadowed-bindings)
  (defn shadowed-bindings [bindings]
    (let-do [out (the (Array String) [])
             pairs (Int./ (code-count bindings) 2)]
      (for [k 0 pairs]
        (match (binding-name (nth-code-form bindings (Int.* 2 k)))
          (Maybe.Just name)
            (let [j (shadow-index bindings k pairs &name)]
              (when (and (Int.>= j 0)
                         (shadow-dead? bindings k j &name)
                         (not (Array.contains? &out &name)))
                (set! out (Array.push-back out @&name))))
          (Maybe.Nothing) ()))
      out))

  (private shadowed-message)
  (hidden shadowed-message)
  (defn shadowed-message [head names]
    (if (Int.= 1 (Array.length names))
      (fmt
        "%s binding %s is shadowed by a later binding before it is used"
        head
        &(name-list names))
      (fmt
        "%s bindings %s are shadowed by later bindings before they are used"
        head
        &(name-list names))))

  (private rule-shadowed-let-binding)
  (hidden rule-shadowed-let-binding)
  (defn rule-shadowed-let-binding [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (and (Int.>= (code-count items) 3)
                   (not (unquotes-occur? items (code-from items 1))))
            (match (let-form-head (nth-code-form items 0))
              (Maybe.Just head)
                (match-ref (nth-code-form items 1)
                  (Form.Arr bindings)
                    (let [n (code-count bindings)]
                      (if (Int.= n (Int.* 2 (Int./ n 2)))
                        (let [shadowed (shadowed-bindings bindings)]
                          (if (Int.= 0 (Array.length &shadowed))
                            (Maybe.Nothing)
                            (dx info
                                "shadowed-let-binding"
                                &(shadowed-message &head &shadowed)
                                (Form.str f))))
                        (Maybe.Nothing)))
                  _ (Maybe.Nothing))
              (Maybe.Nothing) (Maybe.Nothing))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private defn-form-head)
  (hidden defn-form-head)
  (defn defn-form-head [f]
    (cond
      (sym? f "defn") (Maybe.Just @"defn")
      (sym? f "defn-") (Maybe.Just @"defn-")
      (Maybe.Nothing)))

  (private forward-declaration?)
  (hidden forward-declaration?)
  ; a stub whose body is one of its own parameters stands in for a later
  ; definition
  (defn forward-declaration? [items params]
    (and (Int.= 4 (code-count items))
         (match (binding-name (nth-code-form items 3))
           (Maybe.Just name) (syms-occur? params &name 0)
           (Maybe.Nothing) false)))

  (private unused-parameters)
  (hidden unused-parameters)
  (defn unused-parameters [items params]
    (let-do [out (the (Array String) [])
             n (code-count params)
             body (code-from items 3)]
      (for [k 0 n]
        (match (binding-name (nth-code-form params k))
          (Maybe.Just name)
            (unless (or
                (syms-occur? params &name (code-from params (Int.inc k)))
                (syms-occur? items &name body))
              (set! out (Array.push-back out @&name)))
          (Maybe.Nothing) ()))
      out))

  (private unused-parameter-message)
  (hidden unused-parameter-message)
  (defn unused-parameter-message [head names]
    (if (Int.= 1 (Array.length names))
      (fmt
        "%s parameter %s is never used; prefix it with '-' if that is deliberate"
        head
        &(name-list names))
      (fmt
        "%s parameters %s are never used; prefix them with '-' if that is deliberate"
        head
        &(name-list names))))

  (private rule-unused-defn-parameter)
  (hidden rule-unused-defn-parameter)
  (defn rule-unused-defn-parameter [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (and (Int.>= (code-count items) 4)
                   (not (unquotes-occur? items (code-from items 1))))
            (match (defn-form-head (nth-code-form items 0))
              (Maybe.Just head)
                (match-ref (nth-code-form items 2)
                  (Form.Arr params)
                    (if (forward-declaration? items params)
                      (Maybe.Nothing)
                      (let [unused (unused-parameters items params)]
                        (if (Int.= 0 (Array.length &unused))
                          (Maybe.Nothing)
                          (dx info
                              "unused-defn-parameter"
                              &(unused-parameter-message &head &unused)
                              (Form.str f)))))
                  _ (Maybe.Nothing))
              (Maybe.Nothing) (Maybe.Nothing))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private push-maybe!)
  (hidden push-maybe!)
  (defn push-maybe! [acc m]
    (match m (Maybe.Just d) (Array.push-back acc d) (Maybe.Nothing) acc))

  (private extend!)
  (hidden extend!)
  (defn extend! [acc others]
    (let-do [out acc
             n (Array.length &others)]
      (for [i 0 n]
        (set! out (Array.push-back out @(Array.unsafe-nth &others i))))
      out))

  (private byte-offset-head?)
  (hidden byte-offset-head?)
  ; only the qualified spelling: Array has all five names at the same arities
  (defn byte-offset-head? [f]
    (or (sym? f "String.length")
        (or (sym? f "String.index-of") (sym? f "String.index-of-string"))))

  (private arith-name?)
  (hidden arith-name?)
  (defn arith-name? [name]
    (or (or (= name "+") (= name "-"))
        (or (or (= name "*") (= name "/")) (or (= name "inc") (= name "dec")))))

  (private arith-head?)
  (hidden arith-head?)
  ; an offset that has been adjusted arithmetically is still a byte offset
  (defn arith-head? [f]
    (match-ref f
      (Form.Sym segs)
        (let [n (Array.length segs)]
          (and
            (or (Int.= 1 n)
                (and (Int.= 2 n) (= "Int" (Array.unsafe-nth segs 0))))
            (arith-name? (Array.unsafe-nth segs (Int.dec n)))))
      _ false))

  (private ascii-str?)
  (hidden ascii-str?)
  (defn ascii-str? [f]
    (match-ref f
      (Form.Str s)
        (let-do [ok true]
          (for [i 0 (String.length s)]
            (when (Int.> (Char.to-int (String.char-at s i)) 127) (set! ok false)))
          ok)
      _ false))

  (private const-count?)
  (hidden const-count?)
  ; an ASCII literal counts the same in both spaces, so its length is constant
  (defn const-count? [f]
    (match-ref f
      (Form.Itg _) true
      (Form.Lst items)
        (let [n (code-count items)]
          (and (Int.> n 0)
               (let [h (nth-code-form items 0)]
                 (if (and (Int.= 2 n) (sym? h "String.length"))
                   (ascii-str? (nth-code-form items 1))
                   (and (arith-head? h)
                        (let-do [ok (Int.> n 1)
                                 i 1]
                          (while-do (and ok (Int.< i n))
                            (unless (const-count? (nth-code-form items i))
                              (set! ok false))
                            (set! i (Int.inc i)))
                          ok))))))
      _ false))

  (private byte-offset-call?)
  (hidden byte-offset-call?)
  (defn byte-offset-call? [f]
    (match-ref f
      (Form.Lst items)
        (let [n (code-count items)]
          (and (Int.> n 0)
               (let [h (nth-code-form items 0)]
                 (if (byte-offset-head? h)
                   true
                   (and (arith-head? h)
                        (let-do [hit false
                                 i 1]
                          (while-do (and (not hit) (Int.< i n))
                            (when (byte-offset-call? (nth-code-form items i))
                              (set! hit true))
                            (set! i (Int.inc i)))
                          hit))))))
      _ false))

  (private byte-offset-source)
  (hidden byte-offset-source)
  (defn byte-offset-source [f]
    (match-ref f
      (Form.Lst items)
        (let [h (nth-code-form items 0)]
          (if (byte-offset-head? h)
            (Form.str h)
            (let-do [out @""
                     found false
                     n (code-count items)
                     i 1]
              (while-do (and (not found) (Int.< i n))
                (let [a (nth-code-form items i)]
                  (when-do (byte-offset-call? a)
                    (set! out (byte-offset-source a))
                    (set! found true)))
                (set! i (Int.inc i)))
              out)))
      _ @""))

  (private char-sink)
  (hidden char-sink)
  ; prefix/suffix/slice index the decoded character array, so their
  ; counts are characters
  (defn char-sink [items]
    (let [n (code-count items)]
      (if (Int.= 0 n)
        (Maybe.Nothing)
        (let [h (nth-code-form items 0)]
          (cond
            (and (Int.= 3 n) (sym? h "String.prefix"))
              (Maybe.Just @"String.prefix")
            (and (Int.= 3 n) (sym? h "String.suffix"))
              (Maybe.Just @"String.suffix")
            (and (Int.= 4 n) (sym? h "String.slice"))
              (Maybe.Just @"String.slice")
            (Maybe.Nothing))))))

  (private mixed-index-message)
  (hidden mixed-index-message)
  (defn mixed-index-message [sink source]
    (fmt
      "%s counts characters but %s answers in bytes; one non-ASCII character before the offset mis-slices, and an offset past the character count aborts — cut with String.byte-slice"
      sink
      source))

  (private direct-mixed-index)
  (hidden direct-mixed-index)
  (defn direct-mixed-index [items]
    (match (char-sink items)
      (Maybe.Just sink)
        (let-do [found (the (Maybe String) (Maybe.Nothing))
                 n (code-count items)
                 i 2]
          (while-do (and (Maybe.nothing? &found) (Int.< i n))
            (let [a (nth-code-form items i)]
              (when (and (byte-offset-call? a) (not (const-count? a)))
                (set! found
                      (Maybe.Just
                        (mixed-index-message &sink &(byte-offset-source a))))))
            (set! i (Int.inc i)))
          found)
      (Maybe.Nothing) (Maybe.Nothing)))

  (private mentions-offset?)
  (hidden mentions-offset?)
  (defn mentions-offset? [f name]
    (or (sym? f name)
        (match-ref f
          (Form.Lst items)
            (let [n (code-count items)]
              (and (Int.> n 0)
                   (and (arith-head? (nth-code-form items 0))
                        (let-do [hit false
                                 i 1]
                          (while-do (and (not hit) (Int.< i n))
                            (when (mentions-offset? (nth-code-form items i) name)
                              (set! hit true))
                            (set! i (Int.inc i)))
                          hit))))
          _ false)))

  (private indexes-with?)
  (hidden indexes-with?)
  (defn indexes-with? [items name]
    (let-do [hit false
             n (code-count items)
             i 2]
      (while-do (and (not hit) (Int.< i n))
        (when (mentions-offset? (nth-code-form items i) name) (set! hit true))
        (set! i (Int.inc i)))
      hit))

  (private data-list?)
  (hidden data-list?)
  (defn data-list? [items]
    (and (Int.= 2 (code-count items)) (sym? (nth-code-form items 0) "quote")))

  (private dynamic-form?)
  (hidden dynamic-form?)
  ; a defndynamic or defmacro body runs in the compiler, where these are
  ; dynamic builtins over the evaluator's own strings
  (defn dynamic-form? [items]
    (and (Int.> (code-count items) 0)
         (let [h (nth-code-form items 0)]
           (or (sym? h "defndynamic") (sym? h "defmacro")))))

  (private rebinds?)
  (hidden rebinds?)
  (defn rebinds? [items name]
    (and (Int.>= (code-count items) 2)
         (and
           (Maybe.just? &(let-form-head (nth-code-form items 0)))
           (match-ref (nth-code-form items 1)
             (Form.Arr bindings)
               (let-do [hit false
                        pairs (Int./ (code-count bindings) 2)]
                 (for [k 0 pairs]
                   (match (binding-name (nth-code-form bindings (Int.* 2 k)))
                     (Maybe.Just other) (when (= &other name) (set! hit true))
                     (Maybe.Nothing) ()))
                 hit)
             _ false))))

  (private mixed-index-uses)
  (hidden mixed-index-uses)
  ; every character-counting call under `items` indexed with `name`
  (defn mixed-index-uses [items name source from]
    (let-do [acc (the (Array Diagnostic) [])
             i from
             n (Array.length items)]
      (while-do (Int.< i n)
        (let [l (nth-located items i)]
          (match-ref (Located.form l)
            (Form.Lst kids)
              (unless-do (or (data-list? kids) (dynamic-form? kids))
                (match (char-sink kids)
                  (Maybe.Just sink)
                    (when (indexes-with? kids name)
                      (set! acc
                            (push-maybe! acc
                                         (dx (Located.info l)
                                             "byte-offset-as-char-index"
                                             &(mixed-index-message &sink source)
                                             (Form.str (Located.form l))))))
                  (Maybe.Nothing) ())
                (unless (rebinds? kids name)
                  (set! acc (extend! acc (mixed-index-uses kids name source 0)))))
            (Form.Arr kids)
              (set! acc (extend! acc (mixed-index-uses kids name source 0)))
            (Form.StaticArr kids)
              (set! acc (extend! acc (mixed-index-uses kids name source 0)))
            (Form.Dict kids)
              (set! acc (extend! acc (mixed-index-uses kids name source 0)))
            _ ()))
        (set! i (Int.inc i)))
      acc))

  (private let-bound-mixed-index)
  (hidden let-bound-mixed-index)
  (defn let-bound-mixed-index [items bindings]
    (let-do [acc (the (Array Diagnostic) [])
             pairs (Int./ (code-count bindings) 2)
             k 0]
      (while-do (Int.< k pairs)
        (let [ni (Int.* 2 k)
              init (nth-code-form bindings (Int.inc ni))]
          (when (and (byte-offset-call? init) (not (const-count? init)))
            (match (binding-name (nth-code-form bindings ni))
              (Maybe.Just name)
                (let-do [source (byte-offset-source init)]
                  (set! acc
                        (extend! acc
                                 (mixed-index-uses bindings
                                                   &name
                                                   &source
                                                   (code-from bindings
                                                              (Int.+ ni 2)))))
                  (set! acc
                        (extend! acc
                                 (mixed-index-uses items
                                                   &name
                                                   &source
                                                   (code-from items 2)))))
              (Maybe.Nothing) ())))
        (set! k (Int.inc k)))
      acc))

  (private rule-redundant-do-in-do-variant)
  (hidden rule-redundant-do-in-do-variant)
  (defn rule-redundant-do-in-do-variant [l]
    (let [f (Located.form l)
          info (Located.info l)]
      (match-ref f
        (Form.Lst items)
          (if (Int.= 3 (Array.length items))
            (let [head (nth-form items 0)]
              (match-ref head
                (Form.Sym segs)
                  (if (and (Int.= 1 (Array.length segs))
                           (do-variant? (Array.unsafe-nth segs 0)))
                    (let [body (nth-form items 2)]
                      (if (lst-head? body "do")
                        (dx info
                            "redundant-do-in-do-variant"
                            &(fmt
                              "(%s ... (do ...)) already wraps body in do; the inner do is redundant"
                              (Array.unsafe-nth segs 0))
                            (Form.str f))
                        (Maybe.Nothing)))
                    (Maybe.Nothing))
                _ (Maybe.Nothing)))
            (Maybe.Nothing))
        _ (Maybe.Nothing))))

  (private fix-redundant-do-in-do-variant)
  (hidden fix-redundant-do-in-do-variant)
  (defn fix-redundant-do-in-do-variant [l src]
    (match-ref (Located.form l)
      (Form.Lst items)
        (if (Int.= 3 (Array.length items))
          (match-ref (nth-form items 0)
            (Form.Sym segs)
              (if (and (Int.= 1 (Array.length segs))
                       (and (do-variant? (Array.unsafe-nth segs 0))
                            (lst-head? (nth-form items 2) "do")))
                (splice-fix l
                            src
                            (Array.unsafe-nth segs 0)
                            (nth-located items 1)
                            (nth-located items 2)
                            true)
                (Maybe.Nothing))
            _ (Maybe.Nothing))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private use-form?)
  (hidden use-form?)
  (defn use-form? [f]
    (match-ref f
      (Form.Lst items)
        (and (Int.> (code-count items) 0)
             (let [h (nth-code-form items 0)]
               (or (sym? h "use") (sym? h "use-all"))))
      _ false))

  (private main-defn?)
  (hidden main-defn?)
  (defn main-defn? [f]
    (match-ref f
      (Form.Lst items)
        (and (Int.>= (code-count items) 2)
             (and (sym? (nth-code-form items 0) "defn")
                  (sym? (nth-code-form items 1) "main")))
      _ false))

  (private test-marker?)
  (hidden test-marker?)
  (defn test-marker? [f]
    (match-ref f
      (Form.Sym segs)
        (let [n (Array.length segs)]
          (and (Int.> n 0)
               (let [name (Array.unsafe-nth segs (Int.dec n))]
                 (or
                   (or (= name "deftest") (= name "with-test"))
                   (starts-with-bytes? name "assert-")))))
      _ false))

  (private has-test-marker?)
  (hidden has-test-marker?)
  (defn has-test-marker? [forms]
    (let-do [found false]
      (for [i 0 (Array.length forms)]
        (match-ref (Located.form (Box.peek (Array.unsafe-nth forms i)))
          (Form.Lst items)
            (when (or
                (and (Int.> (code-count items) 0)
                     (test-marker? (nth-code-form items 0)))
                (has-test-marker? items))
              (set! found true))
          (Form.Arr items) (when (has-test-marker? items) (set! found true))
          (Form.StaticArr items)
            (when (has-test-marker? items) (set! found true))
          (Form.Dict items) (when (has-test-marker? items) (set! found true))
          _ ()))
      found))

  (private entry-point-file?)
  (hidden entry-point-file?)
  (defn entry-point-file? [forms]
    (let-do [found false]
      (for [i 0 (Array.length forms)]
        (when (main-defn? (Located.form (Box.peek (Array.unsafe-nth forms i))))
          (set! found true)))
      (or found (has-test-marker? forms))))

  (private node-mixed-index)
  (hidden node-mixed-index)
  (defn node-mixed-index [l items]
    (match (direct-mixed-index items)
      (Maybe.Just msg)
        (push-maybe! (the (Array Diagnostic) [])
                     (dx (Located.info l)
                         "byte-offset-as-char-index"
                         &msg
                         (Form.str (Located.form l))))
      (Maybe.Nothing)
        (if (Int.< (code-count items) 3)
          (the (Array Diagnostic) [])
          (match (let-form-head (nth-code-form items 0))
            (Maybe.Just _)
              (match-ref (nth-code-form items 1)
                (Form.Arr bindings)
                  (let [n (code-count bindings)]
                    (if (Int.= n (Int.* 2 (Int./ n 2)))
                      (let-bound-mixed-index items bindings)
                      (the (Array Diagnostic) [])))
                _ (the (Array Diagnostic) []))
            (Maybe.Nothing) (the (Array Diagnostic) [])))))

  (private same-site?)
  (hidden same-site?)
  (defn same-site? [a b]
    (and
      (Int.= @(Diagnostic.line a) @(Diagnostic.line b))
      (Int.= @(Diagnostic.col a) @(Diagnostic.col b))))

  (private dedupe-sites)
  (hidden dedupe-sites)
  ; a sink reachable both directly and through a binding is one finding
  (defn dedupe-sites [ds]
    (let-do [out (the (Array Diagnostic) [])]
      (for [i 0 (Array.length &ds)]
        (let-do [d (Array.unsafe-nth &ds i)
                 seen false]
          (for [j 0 (Array.length &out)]
            (when (same-site? (Array.unsafe-nth &out j) d) (set! seen true)))
          (unless seen (set! out (Array.push-back out @d)))))
      out))

  (private mixed-index-scan)
  (hidden mixed-index-scan)
  (defn mixed-index-scan [forms]
    (let-do [acc (the (Array Diagnostic) [])
             n (Array.length forms)]
      (for [i 0 n]
        (let [l (nth-located forms i)]
          (match-ref (Located.form l)
            (Form.Lst items)
              (unless-do (or (data-list? items) (dynamic-form? items))
                (set! acc (extend! acc (node-mixed-index l items)))
                (set! acc (extend! acc (mixed-index-scan items))))
            (Form.Arr items) (set! acc (extend! acc (mixed-index-scan items)))
            (Form.StaticArr items)
              (set! acc (extend! acc (mixed-index-scan items)))
            (Form.Dict items) (set! acc (extend! acc (mixed-index-scan items)))
            _ ())))
      acc))

  (private rule-byte-offset-as-char-index)
  (hidden rule-byte-offset-as-char-index)
  (defn rule-byte-offset-as-char-index [forms]
    (dedupe-sites (mixed-index-scan forms)))

  (private rule-leaky-top-level-use)
  (hidden rule-leaky-top-level-use)
  (defn rule-leaky-top-level-use [forms]
    (let-do [out (the (Array Diagnostic) [])]
      (unless (entry-point-file? forms)
        (for [i 0 (Array.length forms)]
          (let [l (Box.peek (Array.unsafe-nth forms i))]
            (when (use-form? (Located.form l))
              (set! out
                    (push-maybe! out
                                 (dx (Located.info l)
                                     "leaky-top-level-use"
                                     "a top-level use leaks into every file that loads this one, where the names it brings in can make a bare name ambiguous; put it inside the defmodule that needs it"
                                     (Form.str (Located.form l)))))))))
      out))

  (private target-file)
  (hidden target-file)
  (def target-file -1)

  (private target-bad)
  (hidden target-bad)
  (def target-bad -2)

  (private lead-len)
  (hidden lead-len)
  (defn lead-len [text]
    (let-do [n (String.length text)
             i 0
             done false]
      (while (and (not done) (Int.< i n))
        (let [c (String.char-at text i)]
          (if (or (Char.= c \;) (or (Char.= c \space) (Char.= c \tab)))
            (set! i (Int.inc i))
            (set! done true))))
      i))

  (private directive-tokens)
  (hidden directive-tokens)
  (defn directive-tokens [text]
    (let-do [raw (String.split-by
               &(String.byte-slice text (lead-len text) (String.length text))
               &[\space \tab \,])
             out (the (Array String) [])]
      (for [i 0 (Array.length &raw)]
        (let [t (Array.unsafe-nth &raw i)]
          (unless (String.empty? t) (set! out (Array.push-back out @t)))))
      out))

  (private make-suppression)
  (hidden make-suppression)
  (defn make-suppression [rules target info text]
    (Maybe.Just
      (Suppression.init rules
                        target
                        @(Info.line info)
                        @(Info.col info)
                        @(Info.pos info)
                        @text)))

  (private parse-directive)
  (hidden parse-directive)
  (defn parse-directive [text info]
    (let [toks (directive-tokens text)]
      (if (Int.= 0 (Array.length &toks))
        (Maybe.Nothing)
        (let [head @(Array.unsafe-nth &toks 0)
              rest (Array.suffix &toks 1)
              line @(Info.line info)]
          (cond
            (= &head "angler-disable-file")
              (make-suppression rest target-file info text)
            (= &head "angler-disable-line")
              (make-suppression rest line info text)
            (= &head "angler-disable-next-line")
              (make-suppression rest (Int.inc line) info text)
            (or (= &head "angler-disable")
                (starts-with-bytes? &head "angler-disable-"))
              (make-suppression (the (Array String) []) target-bad info text)
            (Maybe.Nothing))))))

  (private collect-suppressions)
  (hidden collect-suppressions)
  (defn collect-suppressions [forms]
    (let-do [acc (the (Array Suppression) [])]
      (for [i 0 (Array.length forms)]
        (let-do [l (nth-located forms i)]
          (match-ref (Located.form l)
            (Form.Cmt text)
              (match (parse-directive text (Located.info l))
                (Maybe.Just s) (set! acc (Array.push-back acc s))
                (Maybe.Nothing) ())
            (Form.Lst items)
              (set! acc (extend! acc (collect-suppressions items)))
            (Form.Arr items)
              (set! acc (extend! acc (collect-suppressions items)))
            (Form.StaticArr items)
              (set! acc (extend! acc (collect-suppressions items)))
            (Form.Dict items)
              (set! acc (extend! acc (collect-suppressions items)))
            _ ())))
      acc))

  (private known-rule?)
  (hidden known-rule?)
  (defn known-rule? [name]
    (let-do [found false]
      (for [i 0 (Array.length &*rules*)]
        (when (= name (Rule.name (Array.unsafe-nth &*rules* i)))
          (set! found true)))
      found))

  (private covers?)
  (hidden covers?)
  (defn covers? [s rule line]
    (and
      (or
        (Int.= 0 (Array.length (Suppression.rules s)))
        (Array.contains? (Suppression.rules s) rule))
      (or
        (Int.= target-file @(Suppression.target s))
        (Int.= line @(Suppression.target s)))))

  (private suppressed?)
  (hidden suppressed?)
  (defn suppressed? [sups rule line]
    (let-do [hit false]
      (for [i 0 (Array.length sups)]
        (when (covers? (Array.unsafe-nth sups i) rule line) (set! hit true)))
      hit))

  (private keep-diags)
  (hidden keep-diags)
  (defn keep-diags [sups diags]
    (let-do [out (the (Array Diagnostic) [])]
      (for [i 0 (Array.length diags)]
        (let [d (Array.unsafe-nth diags i)]
          (unless (suppressed? sups (Diagnostic.rule d) @(Diagnostic.line d))
            (set! out (Array.push-back out @d)))))
      out))

  ; a rewrite that swallows a directive un-suppresses it on the next pass.
  (private fix-keeps-directives?)
  (hidden fix-keeps-directives?)
  (defn fix-keeps-directives? [f sups]
    (let-do [ok true
             start @(Fix.start f)
             end @(Fix.end f)]
      (for [i 0 (Array.length sups)]
        (let [s (Array.unsafe-nth sups i)
              p @(Suppression.pos s)]
          (when (and (Int.>= p start) (Int.< p end))
            (unless (String.contains-string? (Fix.replacement f)
                                             &(String.append ";"
                                                             (Suppression.text s)))
              (set! ok false)))))
      ok))

  ; registered only so they list and answer to --only/--disable; the
  ; suppression pass, not the walker, is what fires them.
  (private quiet-rule)
  (hidden quiet-rule)
  (sig quiet-rule (Fn [(Ref Located)] (Maybe Diagnostic)))
  (defn quiet-rule [_] (Maybe.Nothing))

  (private sup-diag)
  (hidden sup-diag)
  (defn sup-diag [s rule msg]
    (Diagnostic.init @rule
                     msg
                     (String.append ";" (Suppression.text s))
                     @(Suppression.line s)
                     @(Suppression.col s)))

  (private sup-used?)
  (hidden sup-used?)
  (defn sup-used? [s diags]
    (let-do [used false]
      (for [i 0 (Array.length diags)]
        (let [d (Array.unsafe-nth diags i)]
          (when (covers? s (Diagnostic.rule d) @(Diagnostic.line d))
            (set! used true))))
      used))

  (private unknown-rules)
  (hidden unknown-rules)
  (defn unknown-rules [s]
    (let-do [out (the (Array String) [])
             rules (Suppression.rules s)]
      (for [i 0 (Array.length rules)]
        (let [r (Array.unsafe-nth rules i)]
          (unless (known-rule? r) (set! out (Array.push-back out @r)))))
      out))

  (private sup-active?)
  (hidden sup-active?)
  (defn sup-active? [s keep?]
    (let-do [rules (Suppression.rules s)
             any (Int.= 0 (Array.length rules))]
      (for [i 0 (Array.length rules)]
        (when (~keep? (Array.unsafe-nth rules i)) (set! any true)))
      any))

  (private suppression-diags)
  (hidden suppression-diags)
  (defn suppression-diags [sups diags keep?]
    (let-do [out (the (Array Diagnostic) [])]
      (for [i 0 (Array.length sups)]
        (let [s (Array.unsafe-nth sups i)
              bad (unknown-rules s)]
          (cond
            (Int.= target-bad @(Suppression.target s))
              (when (~keep? "unknown-suppression-directive")
                (set! out
                      (Array.push-back out
                                       (sup-diag s
                                                 "unknown-suppression-directive"
                                                 @"not a suppression directive; expected angler-disable-file, angler-disable-line or angler-disable-next-line"))))
            (Int.> (Array.length &bad) 0)
              (when (~keep? "unknown-suppression-rule")
                (for [j 0 (Array.length &bad)]
                  (set! out
                        (Array.push-back out
                                         (sup-diag s
                                                   "unknown-suppression-rule"
                                                   (fmt "no rule is called '%s'"
                                                        (Array.unsafe-nth &bad j)))))))
            (not (~keep? "unused-suppression")) ()
            (not (sup-active? s keep?)) ()
            (sup-used? s diags) ()
            (set! out
                  (Array.push-back out
                                   (sup-diag s
                                             "unused-suppression"
                                             @"this directive suppressed nothing"))))))
      out))

  (private lint-form)
  (hidden lint-form)
  (defn lint-form [l keep?]
    (let-do [acc (the (Array Diagnostic) [])
             n (Array.length &*rules*)]
      (for [i 0 n]
        (let-do [r (Array.unsafe-nth &*rules* i)]
          (when (~keep? (Rule.name r))
            (set! acc (push-maybe! acc (~(Rule.fn r) l))))))
      acc))

  (private child-mode)
  (hidden child-mode)
  ; mode is 0 for code, -1 for data under a quote, n under n quasiquotes. the
  ; reader expands 'x, `x, %x and %@x into the two-element lists matched here.
  (defn child-mode [items mode]
    (if (Int.= 2 (code-count items))
      (let [h (nth-code-form items 0)]
        (cond
          (sym? h "quote") (if (Int.> mode 0) mode -1)
          (sym? h "quasiquote") (Int.inc mode)
          (and (Int.> mode 0)
               (or (sym? h "unquote") (sym? h "unquote-splicing")))
            (Int.dec mode)
          mode))
      mode))

  (private walk)
  (hidden walk)
  (defn walk [forms keep? mode]
    (let-do [acc (the (Array Diagnostic) [])
             n (Array.length forms)]
      (for [i 0 n]
        (let-do [l (Box.peek (Array.unsafe-nth forms i))]
          (set! acc (extend! acc (lint-form l keep?)))
          (match-ref (Located.form l)
            (Form.Lst items)
              (let [m (child-mode items mode)]
                (unless (Int.< m 0)
                  (set! acc (extend! acc (walk items keep? m)))))
            (Form.Arr items) (set! acc (extend! acc (walk items keep? mode)))
            (Form.StaticArr items)
              (set! acc (extend! acc (walk items keep? mode)))
            (Form.Dict items) (set! acc (extend! acc (walk items keep? mode)))
            _ ())))
      acc))

  (private file-diags)
  (hidden file-diags)
  (defn file-diags [forms keep?]
    (let-do [acc (the (Array Diagnostic) [])
             n (Array.length &*file-rules*)]
      (for [i 0 n]
        (let [r (Array.unsafe-nth &*file-rules* i)]
          (when (~keep? (FileRule.name r))
            (set! acc (extend! acc (~(FileRule.fn r) forms))))))
      acc))

  (private lint-all)
  (hidden lint-all)
  (defn lint-all [forms keep?]
    (let [sups (collect-suppressions forms)
          diags (extend! (walk forms keep? 0) (file-diags forms keep?))]
      (extend! (keep-diags &sups &diags)
               (keep-diags &sups &(suppression-diags &sups &diags keep?)))))

  (doc lint "applies every registered rule to every node in `forms`,
recursing into compound forms. Returns one `Diagnostic` per finding.

A form under a `quote` is data, and is neither reported nor recursed
into. A form under a `quasiquote` is a template for code, so it is
still reported; the argument of an `unquote` or `unquote-splicing`
inside one is ordinary code again.

Findings covered by an inline `; angler-disable-…` directive are
dropped, and directives that are unused, name a rule that does not
exist, or open like a directive without being one are reported under
`unused-suppression`, `unknown-suppression-rule` and
`unknown-suppression-directive`.

Rules marked with `mark-opt-in!` are skipped; ask for them by name
through `lint-with`.")
  (defn lint [forms] (lint-all forms &(fn [n] (on-by-default? n))))

  (doc lint-with "like `lint`, but only runs rules whose names satisfy
`keep?`. An opt-in rule runs if `keep?` admits it: the caller is
stating the policy.")
  (defn lint-with [keep? forms] (lint-all forms keep?))

  (doc lint-source "parses `src` via `Reader.parse` and lints with
every registered rule that is on by default. Returns `(Result (Array
Diagnostic) ParseErr)` so a parse failure surfaces distinctly from a
clean parse with diagnostics.")
  (defn lint-source [src]
    (match (Reader.parse src)
      (Result.Success forms)
        (Result.Success (lint-all &forms &(fn [n] (on-by-default? n))))
      (Result.Error e) (Result.Error e)))

  (doc lint-source-with "like `lint-source`, but only runs rules whose
names satisfy `keep?`. An opt-in rule runs if `keep?` admits it.")
  (defn lint-source-with [keep? src]
    (match (Reader.parse src)
      (Result.Success forms) (Result.Success (lint-all &forms keep?))
      (Result.Error e) (Result.Error e)))

  (private fix-for)
  (hidden fix-for)
  (defn fix-for [name l src]
    (let-do [result (Maybe.Nothing)
             n (Array.length &*fixes*)]
      (for [i 0 n]
        (let [fr (Array.unsafe-nth &*fixes* i)]
          (when (and (Maybe.nothing? &result) (= name (FixRule.name fr)))
            (set! result (~(FixRule.fn fr) l src)))))
      result))

  (private node-fixes)
  (hidden node-fixes)
  (defn node-fixes [l keep? src sups]
    (let-do [acc (the (Array Fix) [])
             line @(Info.line (Located.info l))
             n (Array.length &*rules*)]
      (for [i 0 n]
        (let [r (Array.unsafe-nth &*rules* i)]
          (when (and
              (and (~keep? (Rule.name r))
                   (not (suppressed? sups (Rule.name r) line)))
              (Maybe.just? &(~(Rule.fn r) l)))
            (match (fix-for (Rule.name r) l src)
              (Maybe.Just f)
                (when (fix-keeps-directives? &f sups)
                  (set! acc (Array.push-back acc f)))
              (Maybe.Nothing) ()))))
      acc))

  (private walk-fixes)
  (hidden walk-fixes)
  (defn walk-fixes [forms keep? src mode sups]
    (let-do [acc (the (Array Fix) [])
             n (Array.length forms)]
      (for [i 0 n]
        (let-do [l (nth-located forms i)]
          (when (Int.= 0 mode)
            (set! acc (extend! acc (node-fixes l keep? src sups))))
          (match-ref (Located.form l)
            (Form.Lst items)
              (let [m (child-mode items mode)]
                (unless (Int.< m 0)
                  (set! acc (extend! acc (walk-fixes items keep? src m sups)))))
            (Form.Arr items)
              (set! acc (extend! acc (walk-fixes items keep? src mode sups)))
            (Form.StaticArr items)
              (set! acc (extend! acc (walk-fixes items keep? src mode sups)))
            (Form.Dict items)
              (set! acc (extend! acc (walk-fixes items keep? src mode sups)))
            _ ())))
      acc))

  (private index-fixes)
  (hidden index-fixes)
  (defn index-fixes [fixes]
    (let-do [out (the (Array (Pair Int Fix)) [])]
      (for [i 0 (Array.length fixes)]
        (set! out
              (Array.push-back out (Pair.init i @(Array.unsafe-nth fixes i)))))
      out))

  (private start-ord)
  (hidden start-ord)
  ; heap order, like core's own `ord`: `>` here sorts ascending. the index
  ; breaks `start` ties, so heapsort's instability cannot reach the output.
  (defn start-ord [a b]
    (let [sa @(Fix.start (Pair.b a))
          sb @(Fix.start (Pair.b b))]
      (if (Int.= sa sb) (Int.> @(Pair.a a) @(Pair.a b)) (Int.> sa sb))))

  (private apply-fixes)
  (hidden apply-fixes)
  (defn apply-fixes [src fixes]
    (let-do [indexed (index-fixes fixes)
             ordered (Array.sorted-by &indexed &start-ord)
             out @""
             at 0
             n (Array.length &ordered)]
      (for [i 0 n]
        (let-do [f (Pair.b (Array.unsafe-nth &ordered i))]
          (when-do (Int.>= @(Fix.start f) at)
            (set! out
                  (String.concat
                    &[out
                      (String.byte-slice src at @(Fix.start f))
                      @(Fix.replacement f)]))
            (set! at @(Fix.end f)))))
      (String.append &out &(String.byte-slice src at (String.length src)))))

  (private fix-once)
  (hidden fix-once)
  (defn fix-once [keep? src]
    (match (Reader.parse src)
      (Result.Success forms)
        (let [fixes (walk-fixes &forms
                                keep?
                                src
                                0
                                &(collect-suppressions &forms))]
          (if (Int.= 0 (Array.length &fixes))
            (Maybe.Nothing)
            (Maybe.Just (apply-fixes src &fixes))))
      (Result.Error _) (Maybe.Nothing)))

  (private fix-passes)
  (hidden fix-passes)
  (def fix-passes 10)

  (private fix-loop)
  (hidden fix-loop)
  (defn fix-loop [keep? src]
    (let-do [out src
             i 0
             done false]
      (while-do (and (not done) (Int.< i fix-passes))
        (match (fix-once keep? &out)
          (Maybe.Just next) (if (= &next &out) (set! done true) (set! out next))
          (Maybe.Nothing) (set! done true))
        (set! i (Int.inc i)))
      out))

  (doc fix-source "applies every registered fix to `src` and returns
the rewritten source. Findings whose rule has no fix, and fixes that
overlap one already applied, are left alone; the rewrite is repeated
until it reaches a fixpoint or a fixed pass limit. Only the bytes of
fixed forms change, so formatting and comments elsewhere are
preserved. A parse error is returned as such, and clean input comes
back byte-identical.

Nothing under a `quote` or a `quasiquote` is ever rewritten: the first
is data, and a splice makes the arity of the second unknowable at lint
time. The argument of an `unquote` or `unquote-splicing` inside a
`quasiquote` is ordinary code, and is fixed as such.")
  (defn fix-source [src]
    (match (Reader.parse src)
      (Result.Success _) (Result.Success (fix-loop &(fn [_] true) @src))
      (Result.Error e) (Result.Error e)))

  (doc fix-source-with "like `fix-source`, but only applies fixes whose
rule names satisfy `keep?`.")
  (defn fix-source-with [keep? src]
    (match (Reader.parse src)
      (Result.Success _) (Result.Success (fix-loop keep? @src))
      (Result.Error e) (Result.Error e)))

  (private -register-builtins)
  (hidden -register-builtins)
  (def -register-builtins
    (do
      (register-pattern-fix-rule! @"lonely-do"
                                  @"(do x) is just x"
                                  "(do ?x)"
                                  @"(do x) is just x"
                                  @"?x")
      (register-pattern-fix-rule! @"empty-do"
                                  @"(do) has no body"
                                  "(do)"
                                  @"(do) has no body"
                                  @"()")
      (register-rule! @"if-with-do"
                      @"(if cond (do …) ()) → (when-do …); (if cond () (do …)) → (unless-do …)"
                      rule-if-with-do)
      (register-fix! @"if-with-do" fix-if-with-do)
      (register-rule! @"if-one-branch-empty"
                      @"(if cond x ()) → (when cond x); (if cond () x) → (unless cond x)"
                      rule-if-one-branch-empty)
      (register-fix! @"if-one-branch-empty" fix-if-one-branch-empty)
      (register-rule! @"form-with-do"
                      @"(let|while|when|unless ... (do ...)) should use the matching -do variant"
                      rule-form-with-do)
      (register-fix! @"form-with-do" fix-form-with-do)
      (register-pattern-fix-rule! @"when-with-not"
                                  @"(when (not c) x) → (unless c x)"
                                  "(when (not ?c) ?x)"
                                  @"(when (not c) x) can be (unless c x)"
                                  @"(unless ?c ?x)")
      (register-pattern-fix-rule! @"when-with-not"
                                  @"(unless (not c) x) → (when c x)"
                                  "(unless (not ?c) ?x)"
                                  @"(unless (not c) x) can be (when c x)"
                                  @"(when ?c ?x)")
      (register-rule! @"when-with-not"
                      @"(when-do (not c) ...) → (unless-do c ...); (unless-do (not c) ...) → (when-do c ...)"
                      rule-when-do-with-not)
      (register-fix! @"when-with-not" fix-when-do-with-not)
      (register-pattern-fix-rule! @"not-equal"
                                  @"(not (= a b)) is just (/= a b)"
                                  "(not (= ?a ?b))"
                                  @"(not (= a b)) is just (/= a b)"
                                  @"(/= ?a ?b)")
      (register-pattern-fix-rule! @"not-equal"
                                  @"(not (/= a b)) is just (= a b)"
                                  "(not (/= ?a ?b))"
                                  @"(not (/= a b)) is just (= a b)"
                                  @"(= ?a ?b)")
      (register-pattern-fix-rule! @"double-not"
                                  @"(not (not x)) is just x"
                                  "(not (not ?x))"
                                  @"(not (not x)) is just x"
                                  @"?x")
      (register-pattern-rule! @"set-self"
                              @"(set! x x) is a no-op"
                              "(set! ?x ?x)"
                              @"(set! x x) is a no-op")
      (register-rule! @"eq-self"
                      @"(= x x) — a variable compared with itself"
                      rule-eq-self)
      (register-rule! @"try-around-atomic"
                      @"Parser.try around Parser.string/Parser.byte is redundant"
                      rule-try-around-atomic)
      (register-rule! @"non-kebab-case-defn"
                      @"defn names should be kebab-case"
                      rule-non-kebab-case-defn)
      (register-rule! @"non-pascal-case-defmodule"
                      @"defmodule names should be PascalCase"
                      rule-non-pascal-case-defmodule)
      (register-pattern-rule! @"identical-if-branches"
                              @"(if cond x x) — both branches are identical"
                              "(if ?c ?x ?x)"
                              @"(if cond x x) — both branches are identical; the condition is pointless")
      (register-pattern-fix-rule! @"if-bool-branches"
                                  @"(if c true false) is just c"
                                  "(if ?c true false)"
                                  @"(if c true false) is just c"
                                  @"?c")
      (register-pattern-fix-rule! @"if-bool-branches"
                                  @"(if c false true) is just (not c)"
                                  "(if ?c false true)"
                                  @"(if c false true) is just (not c)"
                                  @"(not ?c)")
      (register-pattern-fix-rule! @"empty-let-bindings"
                                  @"(let [] body) — empty bindings; just use body directly"
                                  "(let [] ?x)"
                                  @"(let [] body) has no bindings; the let is unnecessary"
                                  @"?x")
      (register-rule! @"nested-if-chain"
                      @"(if c1 x (if c2 ...)) can be a cond expression"
                      rule-nested-if-chain)
      (register-fix! @"nested-if-chain" fix-nested-if-chain)
      (register-rule! @"redundant-do-in-do-variant"
                      @"-do variant with (do ...) body; the inner do is redundant"
                      rule-redundant-do-in-do-variant)
      (register-fix! @"redundant-do-in-do-variant"
                     fix-redundant-do-in-do-variant)
      (register-pattern-rule! @"unsafe-result-unwrap"
                              @"Result.unsafe-from-success can crash; use match instead"
                              "(Result.unsafe-from-success ?x)"
                              @"Result.unsafe-from-success can crash on Error; use match or from-success instead")
      (register-pattern-rule! @"unsafe-maybe-unwrap"
                              @"Maybe.unsafe-from can crash; use match instead"
                              "(Maybe.unsafe-from ?x)"
                              @"Maybe.unsafe-from can crash on Nothing; use match or from instead")
      (register-rule! @"eq-true" @"(= x true) is just x" rule-eq-true)
      (register-fix! @"eq-true" fix-eq-true)
      (register-rule! @"eq-false" @"(= x false) is just (not x)" rule-eq-false)
      (register-fix! @"eq-false" fix-eq-false)
      (register-rule! @"cond-single-branch"
                      @"(cond c v default) is just (if c v default)"
                      rule-cond-single-branch)
      (register-fix! @"cond-single-branch" fix-cond-single-branch)
      (register-rule! @"single-use-let"
                      @"(let [x expr] x) is just expr"
                      rule-single-use-let)
      (register-rule! @"unused-let-binding"
                      @"a let/let-do binding that is never referenced"
                      rule-unused-let-binding)
      (register-rule! @"shadowed-let-binding"
                      @"a let/let-do binding rebound before it is used"
                      rule-shadowed-let-binding)
      (register-rule! @"unused-defn-parameter"
                      @"a defn/defn- parameter that the body never mentions"
                      rule-unused-defn-parameter)
      (register-file-rule! @"byte-offset-as-char-index"
                           @"a byte offset from String.length/index-of used where a character index is expected"
                           rule-byte-offset-as-char-index)
      (register-rule! @"discarded-let-body"
                      @"a let whose body has more than one form; only the first runs"
                      rule-discarded-let-body)
      (register-fix! @"discarded-let-body" fix-discarded-let-body)
      (register-rule! @"unused-suppression"
                      @"an angler-disable directive that suppressed nothing"
                      quiet-rule)
      (register-rule! @"unknown-suppression-rule"
                      @"an angler-disable directive naming a rule that does not exist"
                      quiet-rule)
      (register-rule! @"unknown-suppression-directive"
                      @"a comment that opens like an angler-disable directive but is not one"
                      quiet-rule)
      (register-file-rule! @"leaky-top-level-use"
                           @"a use/use-all at the top level of a file others load"
                           rule-leaky-top-level-use)
      ; a file that nothing loads — an example, a sketch driven by a
      ; framework's own entry point — carries a top-level use harmlessly,
      ; and a rule cannot see from the file whether anything loads it
      (mark-opt-in! @"leaky-top-level-use")
      0)))
