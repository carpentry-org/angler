(load "../angler.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test Lint Form)

(defn lint! [src]
  (match (Lint.lint-source src)
    (Result.Success diags) diags
    (Result.Error _) (Array.zero)))

(defn no-diag? [src] (Int.= 0 (Array.length &(lint! src))))

(defn has-rule? [src rule]
  (let-do [diags (lint! src)
           found false]
    (for [i 0 (Array.length &diags)]
      (when (= rule (Diagnostic.rule (Array.unsafe-nth &diags i)))
        (set! found true)))
    found))

(defn count-rule [src rule]
  (let-do [diags (lint! src)
           n 0]
    (for [i 0 (Array.length &diags)]
      (when (= rule (Diagnostic.rule (Array.unsafe-nth &diags i)))
        (set! n (Int.inc n))))
    n))

; Fires only on a `MARKER` symbol so it doesn't add noise to other
; tests' inputs.
(defn rule-marker [l]
  (let [f (Located.form l)]
    (match-ref f
      (Form.Sym segs)
        (if (and (Int.= 1 (Array.length segs))
                 (= (Array.unsafe-nth segs 0) "MARKER"))
          (Maybe.Just
            (Diagnostic.init @"marker-rule"
                             @"saw a MARKER"
                             (Form.str f)
                             @(Info.line (Located.info l))
                             @(Info.col (Located.info l))))
          (Maybe.Nothing))
      _ (Maybe.Nothing))))

; drops any comment inside the form it rewrites, which is what the
; directive-preserving check has to refuse.
(defn rule-zap [l]
  (if (Lint.lst-head? (Located.form l) "ZAP")
    (Maybe.Just
      (Diagnostic.init @"zap-rule"
                       @"saw a ZAP"
                       @""
                       @(Info.line (Located.info l))
                       @(Info.col (Located.info l))))
    (Maybe.Nothing)))

(defn fix-zap [l _src]
  (Maybe.Just
    (Fix.init @(Info.pos (Located.info l)) @(Info.pos (Located.end l)) @"ZAPPED")))

(defn count-with [keep? src rule]
  (let-do [diags (match (Lint.lint-source-with keep? src)
             (Result.Success d) d
             (Result.Error _) (Array.zero))
           n 0]
    (for [i 0 (Array.length &diags)]
      (when (= rule (Diagnostic.rule (Array.unsafe-nth &diags i)))
        (set! n (Int.inc n))))
    n))

; leaky-top-level-use is opt-in, so a default lint never runs it and an
; assertion made through `has-rule?` would hold whatever the rule does
(defn count-leaky [src] (count-with &(fn [_] true) src "leaky-top-level-use"))

(defn leaky? [src] (Int.> (count-leaky src) 0))

(def -register-test-rule
  (do
    (Lint.register-rule! @"marker-rule"
                         @"fires when it sees a MARKER symbol"
                         rule-marker)
    (Lint.register-pattern-rule! @"test-pattern"
                                 @"fires on (TPAT ?x ?x)"
                                 "(TPAT ?x ?x)"
                                 @"test pattern matched")
    (Lint.register-rule! @"zap-rule" @"fires on a (ZAP …) form" rule-zap)
    (Lint.register-fix! @"zap-rule" fix-zap)
    0))

(defn fix! [src]
  (match (Lint.fix-source src) (Result.Success s) s (Result.Error _) @""))

(defn fixed-point? [src] (let [once (fix! src)] (= &once &(fix! &once))))

(defn parses? [src]
  (match (Lint.lint-source src) (Result.Success _) true (Result.Error _) false))

(defn leftover [src rule] (count-rule &(fix! src) rule))

(defn lint-output [src]
  (let-do [diags (lint! src)
           out @""
           n (Array.length &diags)]
    (for [i 0 n]
      (set! out
            (String.append &out &(Diagnostic.str (Array.unsafe-nth &diags i)))))
    out))

(deftest t
  (assert-true t (has-rule? "(do x)" "lonely-do") "fires on (do x)")
  (assert-false t (has-rule? "(do x y)" "lonely-do") "does not fire on (do x y)")
  (assert-true t
    (has-rule? "(let [a 1] (do a))" "lonely-do")
    "fires on nested (do x) inside let body")

  (assert-true t
    (has-rule? "(if cond (do x y) ())" "if-with-do")
    "fires on (if cond (do x y) ()) — the (when-do …) desugaring")
  (assert-false t
    (has-rule? "(if cond a b)" "if-with-do")
    "does not fire on plain if/else")
  (assert-false t
    (has-rule? "(if cond (println x) (println y))" "if-with-do")
    "does not fire when branches aren't do-forms")
  (assert-false t
    (has-rule? "(if cond (do x) other)" "if-with-do")
    "does not fire when the else arm is not ()")

  (assert-true t
    (has-rule? "(let [a 1] (do a a))" "form-with-do")
    "fires on (let [...] (do ...)) — suggest let-do")
  (assert-true t
    (has-rule? "(while cond (do x y))" "form-with-do")
    "fires on (while ... (do ...)) — suggest while-do")
  (assert-true t
    (has-rule? "(when cond (do x y))" "form-with-do")
    "fires on (when ... (do ...)) — suggest when-do")
  (assert-true t
    (has-rule? "(unless cond (do x y))" "form-with-do")
    "fires on (unless ... (do ...)) — suggest unless-do")
  (assert-false t
    (has-rule? "(let [a 1] a)" "form-with-do")
    "does not fire on plain let body")
  (assert-false t
    (has-rule? "(let [a 1] (foo a))" "form-with-do")
    "does not fire when body isn't a do-form")
  (assert-false t
    (has-rule? "(Foo.bar x (do y))" "form-with-do")
    "does not fire on unrelated forms even with do body")

  (assert-true t
    (has-rule? "(Parser.try (Parser.string @\"foo\"))" "try-around-atomic")
    "fires on Parser.try around Parser.string")
  (assert-true t
    (has-rule? "(Parser.try (Parser.byte \\a))" "try-around-atomic")
    "fires on Parser.try around Parser.byte")
  (assert-false t
    (has-rule? "(Parser.try (Parser.many p))" "try-around-atomic")
    "does not fire on Parser.try around non-atomic")

  (assert-true t
    (has-rule? "(defn FooBar [] 1)" "non-kebab-case-defn")
    "fires on PascalCase defn name")
  (assert-false t
    (has-rule? "(defn foo-bar [] 1)" "non-kebab-case-defn")
    "does not fire on kebab-case defn name")
  (assert-true t
    (has-rule? "(defn- FooBar [] 1)" "non-kebab-case-defn")
    "fires on PascalCase defn- name")
  (assert-true t
    (has-rule? "(defndynamic FooBar [] 1)" "non-kebab-case-defn")
    "fires on PascalCase defndynamic name")
  (assert-false t
    (has-rule? "(defn- foo-bar [] 1)" "non-kebab-case-defn")
    "does not fire on kebab-case defn- name")
  (assert-false t
    (has-rule? "(defndynamic foo-bar [] 1)" "non-kebab-case-defn")
    "does not fire on kebab-case defndynamic name")
  (assert-false t
    (has-rule? "(defn good? [x] true)" "non-kebab-case-defn")
    "predicate suffix ? is fine")

  (assert-true t
    (no-diag? "(defn add [a b] (Int.+ a b))")
    "clean code yields no diagnostics")

  (assert-equal t
    2
    (count-rule "(do x) (if cond (do y) ())" "lonely-do")
    "two lonely-do findings (top level + nested inside if)")

  (assert-true t
    (let [s (lint-output "(do x)")]
      (and (String.contains-string? &s "lonely-do")
           (String.contains-string? &s "(do x)")))
    "Diagnostic.str includes rule name and offending form")

  (assert-true t (has-rule? "; warm-up
(do x)" "lonely-do") "rules survive top-level comments")

  (assert-equal t
    1
    @(Diagnostic.line (Array.unsafe-nth &(lint! "(do x)") 0))
    "diagnostic line matches form's start line")
  (assert-equal t
    1
    @(Diagnostic.col (Array.unsafe-nth &(lint! "(do x)") 0))
    "diagnostic col matches form's start col")
  (assert-equal t 2 @(Diagnostic.line (Array.unsafe-nth &(lint! "
(do x)") 0)) "diagnostic line tracks newlines")
  (assert-equal t
    5
    @(Diagnostic.col (Array.unsafe-nth &(lint! "    (do x)") 0))
    "diagnostic col tracks leading whitespace")

  (assert-true t (has-rule? "(do)" "empty-do") "empty-do fires on (do)")
  (assert-false t
    (has-rule? "(do x)" "empty-do")
    "empty-do does not fire on (do x)")

  (assert-true t
    (has-rule? "(if c x ())" "if-one-branch-empty")
    "if-one-branch-empty fires on (if c x ())")
  (assert-true t
    (has-rule? "(if c () x)" "if-one-branch-empty")
    "if-one-branch-empty fires on (if c () x)")
  (assert-false t
    (has-rule? "(if c (do x) ())" "if-one-branch-empty")
    "if-one-branch-empty suppresses for (if c (do …) ())")
  (assert-false t
    (has-rule? "(if c () (do x))" "if-one-branch-empty")
    "if-one-branch-empty suppresses for (if c () (do …))")
  (assert-false t
    (has-rule? "(if c a b)" "if-one-branch-empty")
    "if-one-branch-empty does not fire on normal if/else")

  (assert-true t
    (has-rule? "(if c (do x) ())" "if-with-do")
    "if-with-do fires on (if c (do …) ()) — when-do desugaring")
  (assert-true t
    (has-rule? "(if c () (do x))" "if-with-do")
    "if-with-do fires on (if c () (do …)) — unless-do desugaring")

  (assert-true t
    (has-rule? "(when (not c) x)" "when-with-not")
    "when-with-not fires on (when (not c) x)")
  (assert-true t
    (has-rule? "(unless (not c) x)" "when-with-not")
    "when-with-not fires on (unless (not c) x)")
  (assert-true t
    (has-rule? "(when-do (not c) x y)" "when-with-not")
    "when-with-not fires on (when-do (not c) ...)")
  (assert-true t
    (has-rule? "(unless-do (not c) x y)" "when-with-not")
    "when-with-not fires on (unless-do (not c) ...)")
  (assert-false t
    (has-rule? "(when-do c x y)" "when-with-not")
    "when-with-not does not fire on plain when-do")
  (assert-false t
    (has-rule? "(when c x)" "when-with-not")
    "when-with-not does not fire on plain when")

  (assert-true t
    (has-rule? "(not (= a b))" "not-equal")
    "not-equal fires on (not (= a b))")
  (assert-false t
    (has-rule? "(not foo)" "not-equal")
    "not-equal does not fire on plain (not foo)")
  (assert-true t
    (has-rule? "(not (/= a b))" "not-equal")
    "not-equal fires on (not (/= a b))")
  (assert-false t
    (has-rule? "(not (/= a b c))" "not-equal")
    "not-equal does not fire on a three-operand /=")

  (assert-true t
    (has-rule? "(not (not x))" "double-not")
    "double-not fires on (not (not x))")
  (assert-false t
    (has-rule? "(not x)" "double-not")
    "double-not does not fire on single not")

  (assert-true t
    (has-rule? "(set! x x)" "set-self")
    "set-self fires on (set! x x)")
  (assert-false t
    (has-rule? "(set! x y)" "set-self")
    "set-self does not fire on (set! x y)")

  (assert-true t (has-rule? "(= x x)" "eq-self") "eq-self fires on (= x x)")
  (assert-true t
    (has-rule? "(= Foo.bar Foo.bar)" "eq-self")
    "eq-self fires on a qualified symbol")
  (assert-false t
    (has-rule? "(= (f a) (f a))" "eq-self")
    "eq-self does not fire on identical calls")
  (assert-false t
    (has-rule? "(= &x &x)" "eq-self")
    "eq-self does not fire on identical refs")
  (assert-false t
    (has-rule? "(= 1 1)" "eq-self")
    "eq-self does not fire on identical literals")
  (assert-false t
    (has-rule? "(= \"a\" \"a\")" "eq-self")
    "eq-self does not fire on identical strings")
  (assert-false t
    (has-rule? "(= [x] [x])" "eq-self")
    "eq-self does not fire on identical arrays")
  (assert-false t
    (has-rule? "(= x y)" "eq-self")
    "eq-self does not fire on (= x y)")
  (assert-false t
    (has-rule? "(= x x x)" "eq-self")
    "eq-self does not fire on a three-operand =")
  (assert-false t
    (has-rule? "(/= x x)" "eq-self")
    "eq-self does not fire on (/= x x)")

  (assert-true t
    (has-rule? "(defmodule my-thing)" "non-pascal-case-defmodule")
    "non-pascal-case-defmodule fires on kebab-case module name")
  (assert-false t
    (has-rule? "(defmodule MyThing)" "non-pascal-case-defmodule")
    "non-pascal-case-defmodule does not fire on PascalCase")
  (assert-false t
    (has-rule? "(defmodule CLI)" "non-pascal-case-defmodule")
    "non-pascal-case-defmodule does not fire on all-caps acronym")

  (assert-true t
    (has-rule? "(if c x x)" "identical-if-branches")
    "identical-if-branches fires on (if c x x)")
  (assert-true t
    (has-rule? "(if c (foo a) (foo a))" "identical-if-branches")
    "identical-if-branches fires on compound identical branches")
  (assert-false t
    (has-rule? "(if c x y)" "identical-if-branches")
    "identical-if-branches does not fire on different branches")
  (assert-false t
    (has-rule? "(if c (foo a) (foo b))" "identical-if-branches")
    "identical-if-branches does not fire on different compound branches")

  (assert-true t
    (has-rule? "(if c true false)" "if-bool-branches")
    "if-bool-branches fires on (if c true false)")
  (assert-true t
    (has-rule? "(if c false true)" "if-bool-branches")
    "if-bool-branches fires on (if c false true)")
  (assert-false t
    (has-rule? "(if c true x)" "if-bool-branches")
    "if-bool-branches does not fire when only one branch is a boolean")
  (assert-false t
    (has-rule? "(if c x false)" "if-bool-branches")
    "if-bool-branches does not fire when the true branch is not a boolean")
  (assert-false t
    (has-rule? "(if c true true)" "if-bool-branches")
    "if-bool-branches does not fire when both branches are true")
  (assert-false t
    (has-rule? "(if c false false)" "if-bool-branches")
    "if-bool-branches does not fire when both branches are false")

  (assert-true t
    (has-rule? "(let [] x)" "empty-let-bindings")
    "empty-let-bindings fires on (let [] x)")
  (assert-false t
    (has-rule? "(let [a 1] a)" "empty-let-bindings")
    "empty-let-bindings does not fire on non-empty bindings")

  (assert-true t
    (has-rule? "(if c1 x (if c2 y z))" "nested-if-chain")
    "nested-if-chain fires on (if c1 x (if c2 y z))")
  (assert-false t
    (has-rule? "(if c x y)" "nested-if-chain")
    "nested-if-chain does not fire on plain if/else")
  (assert-false t
    (has-rule? "(if c (if c2 a b) y)" "nested-if-chain")
    "nested-if-chain does not fire when nested if is in then branch")
  (assert-true t (has-rule? "(if c1 ; why
  x
  (if c2 y z))" "nested-if-chain") "nested-if-chain sees past a comment between the branches")
  (assert-false t (has-rule? "(if c1 x (if c2 y z) ; trailing
  )" "nested-if-chain") "nested-if-chain leaves a trailing comment alone")
  (assert-false t (has-rule? "(if ; why
  c1 x (if c2 y z))" "nested-if-chain") "nested-if-chain leaves a comment before the condition alone")

  (assert-true t
    (has-rule? "(while-do c (do x y))" "redundant-do-in-do-variant")
    "redundant-do-in-do-variant fires on (while-do c (do ...))")
  (assert-true t
    (has-rule? "(let-do [a 1] (do x y))" "redundant-do-in-do-variant")
    "redundant-do-in-do-variant fires on (let-do [...] (do ...))")
  (assert-true t
    (has-rule? "(when-do c (do x y))" "redundant-do-in-do-variant")
    "redundant-do-in-do-variant fires on (when-do c (do ...))")
  (assert-true t
    (has-rule? "(unless-do c (do x y))" "redundant-do-in-do-variant")
    "redundant-do-in-do-variant fires on (unless-do c (do ...))")
  (assert-false t
    (has-rule? "(while-do c x)" "redundant-do-in-do-variant")
    "redundant-do-in-do-variant does not fire on plain while-do body")
  (assert-false t
    (has-rule? "(while-do c x (do y))" "redundant-do-in-do-variant")
    "redundant-do-in-do-variant does not fire when do is not the sole body form")

  (assert-true t
    (has-rule? "(Result.unsafe-from-success x)" "unsafe-result-unwrap")
    "unsafe-result-unwrap fires on (Result.unsafe-from-success x)")
  (assert-false t
    (has-rule? "(Result.from-success x @\"\")" "unsafe-result-unwrap")
    "unsafe-result-unwrap does not fire on safe Result.from-success")
  (assert-false t
    (has-rule?
      "(match r (Result.Success v) v (Result.Error _) @\"\")"
      "unsafe-result-unwrap")
    "unsafe-result-unwrap does not fire on match")

  (assert-true t
    (has-rule? "(Maybe.unsafe-from x)" "unsafe-maybe-unwrap")
    "unsafe-maybe-unwrap fires on (Maybe.unsafe-from x)")
  (assert-false t
    (has-rule? "(Maybe.from x 0)" "unsafe-maybe-unwrap")
    "unsafe-maybe-unwrap does not fire on safe Maybe.from")
  (assert-false t
    (has-rule?
      "(match m (Maybe.Just v) v (Maybe.Nothing) 0)"
      "unsafe-maybe-unwrap")
    "unsafe-maybe-unwrap does not fire on match")

  (assert-true t
    (has-rule? "(= x true)" "eq-true")
    "eq-true fires on (= x true)")
  (assert-true t
    (has-rule? "(= true x)" "eq-true")
    "eq-true fires on (= true x)")
  (assert-false t
    (has-rule? "(= x y)" "eq-true")
    "eq-true does not fire on (= x y)")
  (assert-false t
    (has-rule? "(= x false)" "eq-true")
    "eq-true does not fire on (= x false)")

  (assert-true t
    (has-rule? "(= x false)" "eq-false")
    "eq-false fires on (= x false)")
  (assert-true t
    (has-rule? "(= false x)" "eq-false")
    "eq-false fires on (= false x)")
  (assert-false t
    (has-rule? "(= x y)" "eq-false")
    "eq-false does not fire on (= x y)")
  (assert-false t
    (has-rule? "(= x true)" "eq-false")
    "eq-false does not fire on (= x true)")

  (assert-true t
    (has-rule? "(cond c v default)" "cond-single-branch")
    "cond-single-branch fires on (cond c v default)")
  (assert-false t
    (has-rule? "(cond c1 v1 c2 v2 default)" "cond-single-branch")
    "cond-single-branch does not fire on multi-branch cond")
  (assert-false t
    (has-rule? "(if c v default)" "cond-single-branch")
    "cond-single-branch does not fire on if")

  (assert-true t
    (has-rule? "(let [x 1] x)" "single-use-let")
    "single-use-let fires on (let [x 1] x)")
  (assert-true t
    (has-rule? "(let [res (foo)] res)" "single-use-let")
    "single-use-let fires on (let [res (foo)] res)")
  (assert-false t
    (has-rule? "(let [x 1] (+ x 1))" "single-use-let")
    "single-use-let does not fire when body uses binding in expression")
  (assert-false t
    (has-rule? "(let [x 1 y 2] x)" "single-use-let")
    "single-use-let does not fire on multi-binding let")
  (assert-false t
    (has-rule? "(let [x 1] y)" "single-use-let")
    "single-use-let does not fire when body is a different variable")

  (assert-true t
    (has-rule? "(let [unused 1 used 2] used)" "unused-let-binding")
    "unused-let-binding fires on a binding no later form mentions")
  (assert-true t
    (has-rule? "(let-do [dead 1] (foo) 0)" "unused-let-binding")
    "unused-let-binding fires on let-do")
  (assert-false t
    (has-rule? "(let [x 1] (+ x 1))" "unused-let-binding")
    "unused-let-binding does not fire when the body uses the binding")
  (assert-false t
    (has-rule? "(let [x 1 y x] y)" "unused-let-binding")
    "a later initialiser counts as a use")
  (assert-false t
    (has-rule? "(let-do [x 1] (set! x 2) 0)" "unused-let-binding")
    "set! counts as a use")
  (assert-false t
    (has-rule? "(let [x 1] (Foo.x))" "unused-let-binding")
    "a dotted symbol segment counts as a use")
  (assert-false t
    (has-rule? "(let [x 1 x 2] x)" "unused-let-binding")
    "a shadowed binding is not reported")
  (assert-false t
    (has-rule? "(let [_ (side-effect)] 0)" "unused-let-binding")
    "an underscore binding is not reported")
  (assert-false t
    (has-rule? "(let [_tmp (side-effect)] 0)" "unused-let-binding")
    "an underscore-prefixed binding is not reported")
  (assert-false t
    (has-rule? "(let [-tmp (side-effect)] 0)" "unused-let-binding")
    "a dash-prefixed binding is not reported")
  (assert-false t
    (has-rule? "(let [x 1 y] x)" "unused-let-binding")
    "an odd binding vector is left alone")
  (assert-false t
    (has-rule? "(let [x 1])" "unused-let-binding")
    "a let with no body is left alone")
  (assert-false t
    (has-rule? "(let x 1)" "unused-let-binding")
    "a let without a binding vector is left alone")
  (assert-true t (has-rule? "(let [x 1 ; note
 y 2] y)" "unused-let-binding") "a comment in the binding vector does not shift the pairs")
  (assert-false t (has-rule? "(let [x 1 ; note
 y 2] (+ x y))" "unused-let-binding") "a comment in the binding vector does not hide a use")
  (assert-true t
    (has-rule? "(let [x 1] (let [y 2] x))" "unused-let-binding")
    "a nested let is checked on its own")
  (assert-false t
    (has-rule? "(let [x 1] (let [y 2] (+ x y)))" "unused-let-binding")
    "a use inside a nested let counts")
  (assert-false t
    (has-rule? "(defmacro m [] (let [n 1] `(foo %n)))" "unused-let-binding")
    "an unquoted use inside a quasiquote counts")
  (assert-false t
    (has-rule? "(defmacro m [] (let [n 1] `(foo n)))" "unused-let-binding")
    "a name inside a quasiquote counts as a use")
  (assert-true t
    (has-rule? "(defmacro m [] (let [n 1] `(foo z)))" "unused-let-binding")
    "a quasiquote that does not mention the name does not save it")
  (assert-false t
    (has-rule? "(defmacro m [body] `(let [tmp 1] %body))" "unused-let-binding")
    "an unquote in the body silences the let")
  (assert-false t
    (has-rule?
      "(defmacro m [:rest body] `(let-do [tmp 1] %@body))"
      "unused-let-binding")
    "an unquote-splicing in the body silences the let")
  (assert-false t
    (has-rule?
      "(defmacro m [body] `(let [tmp 1] (do (foo) %body)))"
      "unused-let-binding")
    "an unquote nested in the body silences the let")
  (assert-false t
    (has-rule?
      "(defmacro m [init] `(let [tmp %init x 1] tmp))"
      "unused-let-binding")
    "an unquote in an initialiser silences the let")
  (assert-equal t
    1
    (count-rule "(let [a 1 b 2] 3)" "unused-let-binding")
    "several unused bindings in one let are one finding")
  (assert-true t
    (String.contains-string? &(lint-output "(let [a 1 b 2] 3)")
                             "let bindings 'a', 'b' are never used")
    "the message names every unused binding")
  (assert-true t
    (String.contains-string?
      &(lint-output "(let-do [dead 1] (foo) 0)")
      "let-do binding 'dead' is never used")
    "the message names the head form")

  (assert-true t
    (has-rule?
      "(String.prefix s (String.index-of s \\%))"
      "byte-offset-as-char-index")
    "byte-offset-as-char-index fires on index-of feeding prefix")
  (assert-true t
    (has-rule? "(String.suffix s (String.length s))" "byte-offset-as-char-index")
    "byte-offset-as-char-index fires on length feeding suffix")
  (assert-true t
    (has-rule?
      "(String.slice s 0 (String.index-of-string s \"x\"))"
      "byte-offset-as-char-index")
    "byte-offset-as-char-index fires on the second index of slice")
  (assert-true t
    (has-rule?
      "(let [i (String.index-of s \\%)] (String.prefix s i))"
      "byte-offset-as-char-index")
    "a let binding carries the byte offset to the call site")
  (assert-true t
    (has-rule?
      "(let-do [i (String.index-of s \\%)] (f) (String.suffix s i))"
      "byte-offset-as-char-index")
    "let-do binds the same way")
  (assert-true t
    (has-rule?
      "(let [i (String.index-of s \\%)] (g (h (String.prefix s i))))"
      "byte-offset-as-char-index")
    "the use is found however deep in the body it sits")
  (assert-true t
    (has-rule?
      "(String.prefix s (Int.dec (String.index-of s \\%)))"
      "byte-offset-as-char-index")
    "an offset that has been adjusted arithmetically is still a byte offset")
  (assert-true t
    (has-rule?
      "(let [i (String.index-of s \\%)] (String.slice s 0 (Int.+ i 1)))"
      "byte-offset-as-char-index")
    "the arithmetic may sit between the binding and the call")
  (assert-true t
    (has-rule?
      "(let [i (String.index-of s \\%)] (String.prefix s (dec i)))"
      "byte-offset-as-char-index")
    "the bare arithmetic spellings count too")
  (assert-equal t
    2
    (count-rule "(defn f [s] (String.prefix s (String.length s)))
(defn g [s] (String.suffix s (String.length s)))" "byte-offset-as-char-index")
    "every offending site in a file is reported")
  (assert-equal t
    2
    (count-rule
      "(defn f [s] (let [i (String.index-of s \\=)] (do (g (String.prefix s i)) (g (String.suffix s i)))))"
      "byte-offset-as-char-index")
    "every sink fed by one binding is reported, not just the first")
  (assert-equal t
    1
    (count-rule
      "(let [i (String.index-of s \\=)] (String.slice s i (String.index-of s \\-)))"
      "byte-offset-as-char-index")
    "a sink reachable both directly and through a binding is one finding")
  (assert-equal t
    2
    (count-rule
      "(let [i (String.index-of s \\=)] (String.prefix (String.suffix s i) i))"
      "byte-offset-as-char-index")
    "a sink nested inside a reported sink is reported too")
  (assert-equal t
    2
    (count-rule
      "(let [i (String.index-of s \\=)] (String.prefix (String.slice s i (String.index-of s \\-)) i))"
      "byte-offset-as-char-index")
    "a nested sink reachable both ways is still one finding each")
  (assert-true t
    (has-rule?
      "(String.prefix s (String.length \"ä\"))"
      "byte-offset-as-char-index")
    "a literal that is not all ASCII counts more bytes than characters")
  (assert-true t
    (has-rule?
      "(String.suffix s (Int.+ i (String.length \"prefix:\")))"
      "byte-offset-as-char-index")
    "a literal length added to an offset of unknown provenance still fires")

  (assert-false t
    (has-rule?
      "(let [i (Pattern.find pat p)] (String.prefix p i))"
      "byte-offset-as-char-index")
    "a Pattern.find offset is left alone; an ASCII-only pattern makes the two spaces coincide")
  (assert-false t
    (has-rule?
      "(if (= \\. (String.char-at s 0)) (String.suffix s 1) @s)"
      "byte-offset-as-char-index")
    "a literal count is not a byte offset")
  (assert-false t
    (has-rule?
      "(String.prefix s (Int.+ 1 (String.length \"ab\")))"
      "byte-offset-as-char-index")
    "a constant written the long way is not a byte offset either")
  (assert-false t
    (has-rule?
      "(let [n (String.length \"ab\")] (String.prefix s n))"
      "byte-offset-as-char-index")
    "an ASCII literal's length is a constant however it reaches the call")
  (assert-false t
    (has-rule? "(String.chars s)" "byte-offset-as-char-index")
    "a call with no index at all is left alone")
  (assert-false t
    (has-rule?
      "(let [n (String.length s)] (String.byte-slice s 0 n))"
      "byte-offset-as-char-index")
    "a byte-space-only loop is correct however much it resembles the bug")
  (assert-false t
    (has-rule?
      "(let [i (String.index-of s \\%)] (Array.prefix xs i))"
      "byte-offset-as-char-index")
    "only String's character-counting calls are sinks")
  (assert-false t
    (has-rule? "(String.prefix s (Array.length xs))" "byte-offset-as-char-index")
    "a bare length is not assumed to be String.length")
  (assert-false t
    (has-rule?
      "(let [n (String.length s)] (prefix bytes n))"
      "byte-offset-as-char-index")
    "a bare prefix is not assumed to be String.prefix; Array has one at the same arity")
  (assert-false t
    (has-rule?
      "(let [n (String.length s)] (slice xs 0 n))"
      "byte-offset-as-char-index")
    "a bare slice is not assumed to be String.slice either")
  (assert-false t
    (has-rule?
      "(let [i (index-of xs 3)] (String.prefix s i))"
      "byte-offset-as-char-index")
    "a bare index-of is not assumed to be String.index-of")
  (assert-false t
    (has-rule?
      "(String.prefix s (Int.dec (Array.length (String.chars s))))"
      "byte-offset-as-char-index")
    "arithmetic on a character count stays a character count")
  (assert-false t
    (has-rule?
      "(defndynamic f [s] (String.prefix s (String.index-of s \\-)))"
      "byte-offset-as-char-index")
    "a defndynamic body runs in the compiler, where these are dynamic builtins")
  (assert-false t
    (has-rule?
      "(defmacro m [s] (String.prefix s (String.index-of s \\-)))"
      "byte-offset-as-char-index")
    "a defmacro body is dynamic too")
  (assert-false t
    (has-rule?
      "'(String.prefix s (String.index-of s \\%))"
      "byte-offset-as-char-index")
    "a quoted call is data and is not reported")
  (assert-false t
    (has-rule?
      "(let [i (String.index-of s \\%)] (let [i 0] (String.prefix s i)))"
      "byte-offset-as-char-index")
    "a rebound name no longer carries the byte offset")
  (assert-true t
    (has-rule?
      "(let [i (String.index-of s \\=)] (let [head (String.prefix s i) i 0] head))"
      "byte-offset-as-char-index")
    "a sink before the rebinding pair still reads the outer offset")
  (assert-true t
    (has-rule?
      "(let [i (String.index-of s \\=)] (let-do [head (String.prefix s i) i 0] head))"
      "byte-offset-as-char-index")
    "let-do rebinds in sequence the same way")
  (assert-true t
    (has-rule?
      "(let [i (String.index-of s \\=)] (let [i (String.prefix s i)] i))"
      "byte-offset-as-char-index")
    "the rebinding pair's own initialiser still reads the outer offset")
  (assert-false t
    (has-rule?
      "(let [i (String.index-of s \\=)] (let [i 0 head (String.prefix s i)] head))"
      "byte-offset-as-char-index")
    "a sink after the rebinding pair reads the new name")
  (assert-true t
    (has-rule?
      "(let [i (String.index-of s \\=) head (String.prefix s i)] head)"
      "byte-offset-as-char-index")
    "a later binding in the same vector carries the byte offset")
  (assert-false t
    (has-rule?
      "(let [i (String.index-of s \\=) i 0 head (String.prefix s i)] head)"
      "byte-offset-as-char-index")
    "a sibling that rebinds the name ends its reach in the same vector")
  (assert-equal t
    1
    (count-rule
      "(let [eq (String.index-of p \\=)] (let [k (String.prefix p eq) eq (Int.inc eq) v (String.suffix p eq)] (String.append &k &v)))"
      "byte-offset-as-char-index")
    "advancing by rebinding reports the sink before it, not the one after")

  (assert-true t
    (has-rule? "(defn f [a b] (foo b))" "unused-defn-parameter")
    "unused-defn-parameter fires on a parameter the body never mentions")
  (assert-true t
    (has-rule? "(defn- g [x] 1)" "unused-defn-parameter")
    "unused-defn-parameter fires on defn-")
  (assert-false t
    (has-rule? "(defn f [a] (+ a 1))" "unused-defn-parameter")
    "unused-defn-parameter does not fire when the body uses the parameter")
  (assert-false t
    (has-rule? "(defn f [a b] (set! a 1) b)" "unused-defn-parameter")
    "set! counts as a use of a parameter")
  (assert-false t
    (has-rule? "(defn f [a] (Foo.a))" "unused-defn-parameter")
    "a dotted symbol segment counts as a use of a parameter")
  (assert-false t
    (has-rule? "(defn f [_ b] (foo b))" "unused-defn-parameter")
    "an underscore parameter is not reported")
  (assert-false t
    (has-rule? "(defn f [_req b] (foo b))" "unused-defn-parameter")
    "an underscore-prefixed parameter is not reported")
  (assert-false t
    (has-rule? "(defn f [-req b] (foo b))" "unused-defn-parameter")
    "a dash-prefixed parameter is not reported")
  (assert-false t
    (has-rule? "(defn len [-v] 0)" "unused-defn-parameter")
    "an interface implementation marks its unused parameter with a dash")
  (assert-false t
    (has-rule? "(defn parse-authority [p res] res)" "unused-defn-parameter")
    "a body that is exactly one parameter is a forward declaration")
  (assert-true t
    (has-rule? "(defn f [a b] (do b))" "unused-defn-parameter")
    "a one-form body that is not a bare parameter is still checked")
  (assert-false t
    (has-rule? "(defn f [a])" "unused-defn-parameter")
    "a defn with no body is left alone")
  (assert-false t
    (has-rule? "(defn f a b)" "unused-defn-parameter")
    "a defn without a parameter vector is left alone")
  (assert-false t
    (has-rule? "(defndynamic d [a b] (foo b))" "unused-defn-parameter")
    "defndynamic is not checked")
  (assert-false t
    (has-rule? "(defmacro m [a b] (foo b))" "unused-defn-parameter")
    "defmacro is not checked")
  (assert-false t
    (has-rule? "'(defn f [a b] (foo b))" "unused-defn-parameter")
    "a quoted defn is data and is not reported")
  (assert-false t
    (has-rule? "(defmacro m [body] `(defn f [a] %body))" "unused-defn-parameter")
    "an unquote in the body silences the defn")
  (assert-false t
    (has-rule? "(defmacro m [] `(defn f [a] (foo a)))" "unused-defn-parameter")
    "a name inside a quasiquote counts as a use")
  (assert-true t (has-rule? "(defn f [a ; note
 b] (foo b))" "unused-defn-parameter") "a comment in the parameter vector does not hide an unused parameter")
  (assert-false t (has-rule? "(defn f [a ; note
 b] (+ a b))" "unused-defn-parameter") "a comment in the parameter vector does not hide a use")
  (assert-equal t
    1
    (count-rule "(defn f [a b] 0)" "unused-defn-parameter")
    "several unused parameters in one defn are one finding")
  (assert-true t
    (String.contains-string? &(lint-output "(defn f [a b] 0)")
                             "defn parameters 'a', 'b' are never used")
    "the message names every unused parameter")
  (assert-true t
    (String.contains-string? &(lint-output "(defn- g [x] 1)")
                             "defn- parameter 'x' is never used")
    "the message names the head form")
  (assert-false t
    (Lint.fixable? "unused-defn-parameter")
    "unused-defn-parameter is deliberately not fixable")

  (assert-true t
    (has-rule? "(let [x 1 x 2] x)" "shadowed-let-binding")
    "shadowed-let-binding fires when the shadowed binding is never used")
  (assert-true t
    (has-rule? "(let-do [x (foo) x 2] (bar x))" "shadowed-let-binding")
    "shadowed-let-binding fires on let-do")
  (assert-false t
    (has-rule? "(let [x 1 x (+ x 1)] x)" "shadowed-let-binding")
    "sequential rebinding is not reported")
  (assert-false t
    (has-rule? "(let [x 1 y x x 2] x)" "shadowed-let-binding")
    "a use in an intervening initialiser counts")
  (assert-false t
    (has-rule? "(let [x 1 y (Foo.x) x 2] x)" "shadowed-let-binding")
    "a dotted symbol segment counts as a use")
  (assert-false t
    (has-rule? "(let [_ 1 _ 2] 0)" "shadowed-let-binding")
    "an underscore binding is not reported")
  (assert-false t
    (has-rule? "(let [x 1 y 2] (+ x y))" "shadowed-let-binding")
    "distinct names are not reported")
  (assert-false t
    (has-rule? "(let [x 1 x 2 y] x)" "shadowed-let-binding")
    "an odd binding vector is left alone")
  (assert-false t
    (has-rule? "(let [x 1 x 2])" "shadowed-let-binding")
    "a let with no body is left alone")
  (assert-false t
    (has-rule?
      "(defmacro m [init] `(let [x 1 x %init] x))"
      "shadowed-let-binding")
    "an unquote in an initialiser silences the let")
  (assert-false t
    (has-rule?
      "(defmacro m [body] `(let [x 1 x 2] %body))"
      "shadowed-let-binding")
    "an unquote in the body silences the let")
  (assert-true t (has-rule? "(let [x 1 ; note
 x 2] x)" "shadowed-let-binding") "a comment in the binding vector does not shift the pairs")
  (assert-equal t
    1
    (count-rule "(let [x 1 x 2 x 3] x)" "shadowed-let-binding")
    "three bindings of one name are one finding")
  (assert-false t
    (has-rule? "(let [x 1 x (+ x 1) x (+ x 1)] x)" "shadowed-let-binding")
    "a chain of sequential rebindings is not reported")
  (assert-true t
    (String.contains-string?
      &(lint-output "(let [a 1 a 2 b 3 b 4] (+ a b))")
      "let bindings 'a', 'b' are shadowed by later bindings")
    "the message names every shadowed binding")
  (assert-true t
    (String.contains-string?
      &(lint-output "(let-do [dead 1 dead 2] dead)")
      "let-do binding 'dead' is shadowed by a later binding")
    "the message names the head form")
  (assert-false t
    (Lint.fixable? "shadowed-let-binding")
    "shadowed-let-binding is deliberately not fixable")

  (assert-true t
    (has-rule? "(let [x 1] (f x) (g x))" "discarded-let-body")
    "discarded-let-body fires on a let with two body forms")
  (assert-true t
    (has-rule? "(let [x 1] (f x) (g x) (h x) (i x))" "discarded-let-body")
    "discarded-let-body fires on a let with many body forms")
  (assert-false t
    (has-rule? "(let [x 1] (f x))" "discarded-let-body")
    "discarded-let-body does not fire on a one-form body")
  (assert-false t
    (has-rule? "(let-do [x 1] (f x) (g x))" "discarded-let-body")
    "discarded-let-body does not fire on let-do")
  (assert-false t
    (has-rule? "(let x 1 2)" "discarded-let-body")
    "a let without a binding vector is left alone")
  (assert-false t (has-rule? "(let [x 1] (f x) ; note
)" "discarded-let-body") "a comment in the body is not a body form")
  (assert-true t
    (has-rule?
      "(defn f [] (let [x 1] (let [y 2] (g y) (h y))))"
      "discarded-let-body")
    "a nested let is checked on its own")
  (assert-true t
    (String.contains-string?
      &(lint-output "(let [x 1] (f x) (g x) (h x))")
      "the first of its 3 body forms")
    "the message counts the body forms")
  (assert-equal t
    "(let-do [x 1] (f x) (g x))"
    &(fix! "(let [x 1] (f x) (g x))")
    "the fix rewrites let to let-do")
  (assert-equal t "(let-do [x 1
      y 2]
  (f x)
  (g y))" &(fix! "(let [x 1
      y 2]
  (f x)
  (g y))") "the fix keeps the body's own layout")
  (assert-true t
    (fixed-point? "(let [x 1] (f x) (g x))")
    "the rewritten let-do is a fixpoint")
  (assert-true t (has-rule? "(let [x 1] (f x) ; note
(g x))" "discarded-let-body") "a comment between body forms does not hide them")
  (assert-equal t "(let [x 1] (f x) ; note
(g x))" &(fix! "(let [x 1] (f x) ; note
(g x))") "a comment in the body blocks the rewrite")
  (assert-true t
    (has-rule? "`(let [x 1] %a %b)" "discarded-let-body")
    "a quasiquoted let is a template for the same bug")
  (assert-equal t
    "`(let [x 1] %a %b)"
    &(fix! "`(let [x 1] %a %b)")
    "a quasiquoted let is not rewritten")
  (assert-false t (has-rule? "; angler-disable-next-line discarded-let-body
(let [x 1] (f x) (g x))" "discarded-let-body") "angler-disable-next-line silences discarded-let-body")

  (assert-true t
    (Lint.opt-in? "leaky-top-level-use")
    "leaky-top-level-use is marked opt-in")
  (assert-false t
    (has-rule? "(use Foo)" "leaky-top-level-use")
    "an opt-in rule stays quiet on a default run")
  (assert-true t (leaky? "(use Foo)") "a top-level use is reported")
  (assert-true t (leaky? "(use-all Foo Bar)") "a top-level use-all is reported")
  (assert-equal t 2 (count-leaky "(use Foo)
(use-all Bar Baz)") "every top-level use is reported, not just the first")
  (assert-false t
    (leaky? "(defmodule Foo (use Bar) (defn f [] 1))")
    "a use inside a defmodule stays inside it and is not reported")
  (assert-false t (leaky? "'(use Foo)") "a quoted use is data")
  (assert-false t (leaky? "(use Foo)
(defn main [] 1)") "a file with a main is nobody's dependency")
  (assert-false t (leaky? "(use Test)
(deftest t t)") "a file with a deftest is nobody's dependency")
  (assert-false t (leaky? "(use Test)
(with-test t t)") "a file with a with-test is nobody's dependency")
  (assert-false t (leaky? "(use Test)
(Suite.defsuite addition (assert-equal test 2 (+ 1 1) \"adds\"))") "a file that asserts something is a test whatever ran it")
  (assert-false t (leaky? "; angler-disable-next-line leaky-top-level-use
(use Foo)") "angler-disable-next-line silences leaky-top-level-use")
  (assert-equal t
    0
    (count-with &(fn [n] (/= n "leaky-top-level-use"))
                "(use Foo)"
                "leaky-top-level-use")
    "disabling leaky-top-level-use drops it")
  (assert-equal t "(use Foo)" &(fix! "(use Foo)") "a file rule has no rewrite")

  (assert-equal t
    40
    (Array.length &(Lint.list-rules))
    "37 built-ins + 3 top-level-registered test rules = 40")

  (assert-equal t
    0
    (count-with &(fn [n] (= n "lonely-do"))
                "(defn FooBar [] 1)"
                "non-kebab-case-defn")
    "filter to lonely-do silences other rules")
  (assert-equal t
    1
    (count-with &(fn [n] (= n "lonely-do")) "(do x)" "lonely-do")
    "filter to lonely-do still fires lonely-do")

  (assert-equal t
    0
    (count-with &(fn [n] (/= n "non-kebab-case-defn"))
                "(defn FooBar [] 1)"
                "non-kebab-case-defn")
    "disabling non-kebab-case-defn drops it")

  (assert-equal t
    40
    (Array.length &(Lint.list-rules))
    "after top-level register, 40 rules total")
  (assert-true t
    (has-rule? "MARKER" "marker-rule")
    "newly-registered rule fires when its pattern appears")
  (assert-false t
    (has-rule? "(defn add [a b] (Int.+ a b))" "marker-rule")
    "newly-registered rule does not fire elsewhere")

  (assert-true t
    (has-rule? "(TPAT a a)" "test-pattern")
    "pattern rule with repeated metavar fires when both match")
  (assert-false t
    (has-rule? "(TPAT a b)" "test-pattern")
    "pattern rule with repeated metavar does not fire when they differ")
  (assert-false t
    (has-rule? "(TPAT a)" "test-pattern")
    "pattern rule does not fire when arity differs")
  (assert-false t
    (has-rule? "(OTHER a a)" "test-pattern")
    "pattern rule does not fire when head symbol differs")

  (assert-true t (no-diag? "; angler-disable-next-line
(do x)") "a bare angler-disable-next-line suppresses every rule on the next line")
  (assert-false t (has-rule? "; angler-disable-next-line lonely-do
(do x)" "lonely-do") "a rule-scoped angler-disable-next-line suppresses that rule")
  (assert-true t (has-rule? "; angler-disable-next-line empty-do
(do x)" "lonely-do") "a directive naming another rule leaves the finding alone")
  (assert-false t (has-rule? "; angler-disable-next-line lonely-do, empty-do
(do x)" "lonely-do") "a rule list may be separated by commas as well as spaces")

  (assert-true t
    (no-diag? "(do x) ; angler-disable-line")
    "a bare trailing angler-disable-line suppresses its own line")
  (assert-false t
    (has-rule? "(do x) ; angler-disable-line lonely-do" "lonely-do")
    "a rule-scoped trailing angler-disable-line suppresses that rule")
  (assert-true t (has-rule? "; angler-disable-line lonely-do
(do x)" "lonely-do") "angler-disable-line on its own line covers no code")

  (assert-true t (no-diag? "; angler-disable-file
(do x)
(do y)") "a bare angler-disable-file suppresses the whole file")
  (assert-true t (Int.= 0 (count-rule "; angler-disable-file lonely-do
(do x)
(do)" "lonely-do")) "a rule-scoped angler-disable-file suppresses that rule everywhere")
  (assert-true t (has-rule? "; angler-disable-file lonely-do
(do x)
(do)" "empty-do") "a rule-scoped angler-disable-file leaves other rules alone")

  (assert-false t (has-rule? "(defn f []
  ; angler-disable-next-line lonely-do
  (do x))" "lonely-do") "a directive written inside a form works")
  (assert-true t (has-rule? "(defn FooBar []
  ; angler-disable-next-line lonely-do
  (do x))" "non-kebab-case-defn") "a directive covers one line, not the form that encloses it")

  (assert-true t (has-rule? "; angler-disable-next-line lonely-do
(defn f []
  (do x))" "lonely-do") "a directive covers the next line only, not the form it opens")
  (assert-equal t 1 (count-rule "; angler-disable-next-line lonely-do
(defn f []
  (do x))" "unused-suppression") "a directive whose rule fires further down is reported unused")
  (assert-equal t 1 (count-rule "; angler-disable-next-line lonely-do
(do x y)" "unused-suppression") "a directive that matches no finding is reported unused")
  (assert-equal t 0 (count-rule "; angler-disable-next-line lonely-do
(do x)" "unused-suppression") "a directive that suppressed something is not reported unused")

  (assert-equal t 1 (count-rule "; angler-disable-next-line lonley-do
(do x)" "unknown-suppression-rule") "a directive naming a rule that does not exist is reported")
  (assert-equal t 0 (count-rule "; angler-disable-next-line lonley-do
(do x)" "unused-suppression") "a typo'd rule name is reported once, not twice")
  (assert-equal t 1 (count-rule "; angler-disable-nextline lonely-do
(do x)" "unknown-suppression-directive") "a comment that opens like a directive but is not one is reported")
  (assert-equal t 0 (count-rule "; see angler-disable-next-line for a way out
(do x)" "unknown-suppression-directive") "an ordinary comment mentioning a directive is still an ordinary comment")
  (assert-equal t 1 (count-rule "; angler-disable-lines lonely-do
(do x)" "unknown-suppression-directive") "a directive name with a typo after the last hyphen is reported")
  (assert-equal t 1 (count-rule "; angler-disable
(do x)" "unknown-suppression-directive") "a bare angler-disable names no directive and is reported")
  (assert-equal t 0 (count-rule "; angler-disabled temporarily
(do x)" "unknown-suppression-directive") "prose whose first word merely begins with angler-disable is an ordinary comment")
  (assert-equal t 0 (count-rule "; angler-disables nothing here
(do x)" "unknown-suppression-directive") "prose is an ordinary comment however the word ends")
  (assert-true t (has-rule? "; angler-disabled temporarily
(do x)" "lonely-do") "prose suppresses nothing")

  (assert-true t (has-rule? "; ’’’’’
(do x)" "lonely-do") "a comment as long in bytes as a directive is still prose")
  (assert-true t (has-rule? "; ’’’’’’’’
(do x)" "lonely-do") "a comment of multi-byte characters is still prose")
  (assert-equal t 0 (count-rule "; ’’’’’’’’
(do x)" "unknown-suppression-directive") "a multi-byte comment does not open like a directive")
  (assert-true t
    (String.contains-string? &(lint-output "; ’’’’’’’’
(do x)") "2:1:")
    "a multi-byte comment does not move a later finding")
  (assert-false t (has-rule? "; angler-disable-next-line lonely-do
(do \"’’’’’’’’\")" "lonely-do") "a directive covers a line holding multi-byte text")
  (assert-true t
    (has-rule? "(let [naïve 1] (do naïve))" "lonely-do")
    "a rule fires around a multi-byte binding name")

  (assert-equal t
    0
    (count-with &(fn [n] (= n "lonely-do"))
                "; angler-disable-next-line lonely-do
(do x)"
                "lonely-do")
    "a directive still suppresses under --only")
  (assert-equal t
    0
    (count-with &(fn [n] (= n "empty-do")) "; angler-disable-next-line lonely-do
(do x)" "unused-suppression")
    "--only for another rule reports no unused directives")
  (assert-equal t
    0
    (count-with &(fn [n] (/= n "lonely-do"))
                "; angler-disable-next-line lonely-do
(do x)"
                "unused-suppression")
    "a directive for a rule --disable already turned off is not unused")
  (assert-equal t
    1
    (count-with &(fn [n] (/= n "empty-do"))
                "; angler-disable-next-line lonely-do
(do x y)"
                "unused-suppression")
    "--disable of another rule leaves unused reporting on")
  (assert-true t (no-diag? "; angler-disable-file unused-suppression
; angler-disable-next-line lonely-do
(do x y)") "unused reporting can itself be switched off by a directive")

  (assert-equal t "; angler-disable-next-line lonely-do
(do x)
" &(fix! "; angler-disable-next-line lonely-do
(do x)
") "--fix leaves a suppressed finding byte-identical")
  (assert-equal t "; angler-disable-next-line lonely-do
(do x)
y
" &(fix! "; angler-disable-next-line lonely-do
(do x)
(do y)
") "--fix still rewrites the findings a directive does not cover")
  (assert-equal t "; angler-disable-file
(do x)
(let [a 1] (do a a))
" &(fix! "; angler-disable-file
(do x)
(let [a 1] (do a a))
") "--fix rewrites nothing under angler-disable-file")
  (assert-equal t "(ZAP
  ; angler-disable-file lonely-do
  q)
(do w)
" &(fix! "(ZAP
  ; angler-disable-file lonely-do
  q)
(do w)
") "a rewrite that would drop a directive is not applied")
  (assert-equal t "ZAPPED
w
" &(fix! "(ZAP
  ; an ordinary comment
  q)
(do w)
") "the same rewrite goes through when the comment is not a directive")

  (assert-true t
    (match (Lint.load-rules-from-source!
        "[(identity ?x) \"identity-wrap\" \"identity is a no-op\"]")
      (Result.Success n) (Int.= 1 n)
      _ false)
    "loads one rule from source")
  (assert-true t
    (has-rule? "(identity x)" "identity-wrap")
    "loaded rule fires on matching form")
  (assert-false t
    (has-rule? "(foo x)" "identity-wrap")
    "loaded rule does not fire on non-matching form")
  (assert-true t (match (Lint.load-rules-from-source! "; a comment
[(?x ?x) \"dup-call\" \"duplicate call\"]") (Result.Success n) (Int.= 1 n) _
        false) "loads rules alongside comments")
  (assert-true t
    (has-rule? "(foo foo)" "dup-call")
    "dup-call rule fires on matching form")
  (assert-false t
    (has-rule? "(foo bar)" "dup-call")
    "dup-call rule does not fire on non-matching form")
  (assert-true t
    (match (Lint.load-rules-from-source! "[(broken")
      (Result.Error _) true
      _ false)
    "returns error on malformed source")
  (assert-true t
    (match (Lint.load-rules-from-source! "(not-an-array \"name\" \"msg\")")
      (Result.Success n) (Int.= 0 n)
      _ false)
    "skips non-array top-level forms")
  (assert-true t
    (match (Lint.lint-source "(def s \"abc")
      (Result.Error _) true
      (Result.Success _) false)
    "surfaces a parse error for an unterminated string")
  (assert-true t
    (match (Lint.lint-source "(def s \"\\uZZZZ\")")
      (Result.Success _) true
      (Result.Error _) false)
    "a malformed escape parses, as the reference reader reads it")
  (assert-true t
    (parses? "(def s \"\\q\")")
    "an unknown escape is read as written, the way the compiler reads it")
  (assert-equal t "1:1: [lonely-do] (do x) is just x
  at: (do \"\\a\")" &(lint-output "(do \"\\a\")") "a named control escape reaches the diagnostic as an escape")
  (assert-equal t "1:1: [lonely-do] (do x) is just x
  at: (do \"\\u0001\")" &(lint-output "(do \"\\u0001\")") "an unnamed control byte reaches the diagnostic as \\uXXXX")
  (assert-equal t
    42
    (Array.length &(Lint.list-rules))
    "40 previous + 2 loaded from source = 42")

  (assert-equal t "x" &(fix! "(do  x )") "lonely-do fix unwraps the body")
  (assert-equal t
    "\"\\a\""
    &(fix! "(do \"\\a\")")
    "a fix copies the source text, so a control escape survives verbatim")
  (assert-equal t
    "(/= a b)"
    &(fix! "(not (= a b))")
    "not-equal fix rewrites to /=")
  (assert-equal t
    "(= a b)"
    &(fix! "(not (/= a b))")
    "not-equal fix rewrites /= back to =")
  (assert-equal t "x" &(fix! "(not (not  x))") "double-not fix unwraps twice")
  (assert-equal t
    "(unless c x)"
    &(fix! "(when (not c) x)")
    "when-with-not fix rewrites when to unless")
  (assert-equal t
    "(when c x)"
    &(fix! "(unless (not c) x)")
    "when-with-not fix rewrites unless to when")
  (assert-equal t
    "(unless-do c a b)"
    &(fix! "(when-do (not c) a b)")
    "when-with-not fix rewrites when-do to unless-do")
  (assert-equal t
    "(when-do c a b)"
    &(fix! "(unless-do (not c) a b)")
    "when-with-not fix rewrites unless-do to when-do")
  (assert-equal t
    "(unless-do (f x) a)"
    &(fix! "(when-do (not (f x)) a)")
    "the negated condition keeps its own bytes")
  (assert-equal t
    "x"
    &(fix! "(let [] x)")
    "empty-let-bindings fix drops the let")
  (assert-equal t "x" &(fix! "(= x true)") "eq-true fix keeps the left operand")
  (assert-equal t "x" &(fix! "(= true x)") "eq-true fix keeps the right operand")
  (assert-equal t
    "(not x)"
    &(fix! "(= x false)")
    "eq-false fix wraps the operand in not")
  (assert-equal t
    "(not y)"
    &(fix! "(= false y)")
    "eq-false fix wraps the right operand in not")
  (assert-equal t
    "c"
    &(fix! "(if c true false)")
    "if-bool-branches fix keeps the condition")
  (assert-equal t
    "(not c)"
    &(fix! "(if c false true)")
    "if-bool-branches fix negates the condition")
  (assert-equal t
    "(foo a b)"
    &(fix! "(if (foo a b) true false)")
    "the kept condition keeps its own bytes")
  (assert-equal t
    "(= x x)"
    &(fix! "(= x x)")
    "eq-self is reported but never rewritten")

  (assert-equal t
    "x"
    &(fix! "(do (do x))")
    "nested findings converge on a later pass")
  (assert-equal t
    "(/= a b)"
    &(fix! "(not (not (not (= a b))))")
    "double-not and not-equal compose across passes")
  (assert-equal t
    "y"
    &(fix! "(if (not y) false true)")
    "if-bool-branches and double-not compose across passes")

  (assert-equal t
    "(defn add [a b] (Int.+ a b))"
    &(fix! "(defn add [a b] (Int.+ a b))")
    "source without findings comes back byte-identical")
  (assert-equal t
    "(defn FooBar [] 1)"
    &(fix! "(defn FooBar [] 1)")
    "rule without a registered fix leaves the source untouched")
  (assert-true t
    (has-rule? "(defn FooBar [] 1)" "non-kebab-case-defn")
    "rule without a registered fix still reports its diagnostic")

  (assert-equal t "; head
x ; tail
  (unless c y)" &(fix! "; head
(do   x) ; tail
  (when (not c) y)") "fixes preserve surrounding comments and indentation")
  (assert-equal t "(unless c (foo
    bar))" &(fix! "(when (not c)
  (foo
    bar))") "a spliced sub-form keeps its own line breaks")
  (assert-equal t "(do ; hi
)" &(fix! "(do ; hi
)") "a metavariable bound to a comment is not fixed")

  (assert-equal t
    "@x"
    &(fix! "(do @x)")
    "reader-macro forms survive being spliced as a body")

  (assert-true t
    (has-rule? "(do %@forms)" "lonely-do")
    "lonely-do still reports an unquote-splicing body")
  (assert-equal t
    "(do %@forms)"
    &(fix! "(do %@forms)")
    "unwrapping an unquote-splicing body is refused")
  (assert-true t
    (has-rule? "(= %@forms true)" "eq-true")
    "eq-true still reports an unquote-splicing operand")
  (assert-equal t
    "(= %@forms true)"
    &(fix! "(= %@forms true)")
    "unwrapping an unquote-splicing operand is refused")
  (assert-true t
    (has-rule? "(when-do (not %@forms) a b)" "when-with-not")
    "when-with-not still reports an unquote-splicing condition")
  (assert-equal t
    "(when-do (not %@forms) a b)"
    &(fix! "(when-do (not %@forms) a b)")
    "hoisting an unquote-splicing condition out of the not is refused")
  (assert-equal t "(unless-do c
    a
    b)" &(fix! "(when-do (not c)
    a
    b)") "a multi-line -do body stays where it was")
  (assert-equal t "(when-do (not c) ; hi
  a)" &(fix! "(when-do (not c) ; hi
  a)") "a comment among the -do form's children refuses the rewrite")

  (assert-equal t
    "(let-do [x 1] a b)"
    &(fix! "(let [x 1] (do a b))")
    "form-with-do fix splices the do body into let-do")
  (assert-equal t
    "(while-do c x y)"
    &(fix! "(while c (do x y))")
    "form-with-do fix rewrites while to while-do")
  (assert-equal t
    "(when-do c x y)"
    &(fix! "(when c (do x y))")
    "form-with-do fix rewrites when to when-do")
  (assert-equal t
    "(unless-do c x y)"
    &(fix! "(unless c (do x y))")
    "form-with-do fix rewrites unless to unless-do")
  (assert-equal t "(let-do [x 1]
    a
    b)" &(fix! "(let [x 1]
  (do
    a
    b))") "a multi-line do body stays multi-line")
  (assert-equal t "(let-do [x 1] ; why
    a)" &(fix! "(let [x 1]
  (do ; why
    a))") "a comment inside the spliced body survives")
  (assert-equal t
    "( let-do [x 1] a b)"
    &(fix! "( let [x 1] (do a b))")
    "the bytes between the paren and the head are kept")

  (assert-equal t
    "(let-do [x 1] a b)"
    &(fix! "(let-do [x 1] (do a b))")
    "redundant-do-in-do-variant fix drops the inner do")
  (assert-equal t
    "(while-do c a b)"
    &(fix! "(while-do c (do a b))")
    "redundant-do-in-do-variant fix works for while-do")
  (assert-equal t
    "(unless-do c a b)"
    &(fix! "(unless-do c (do a b))")
    "redundant-do-in-do-variant fix works for unless-do")

  (assert-equal t
    "(when-do c a b)"
    &(fix! "(if c (do a b) ())")
    "if-with-do fix rewrites to when-do")
  (assert-equal t
    "(unless-do c a b)"
    &(fix! "(if c () (do a b))")
    "if-with-do fix rewrites to unless-do")
  (assert-equal t "(when-do c
    a
    b)" &(fix! "(if c
  (do
    a
    b)
  ())") "if-with-do keeps a multi-line body multi-line")
  (assert-equal t "(unless-do c
    a
    b)" &(fix! "(if c
  ()
  (do
    a
    b))") "if-with-do drops the empty then-branch across lines")

  (assert-equal t
    "(when c x)"
    &(fix! "(if c x ())")
    "if-one-branch-empty fix rewrites to when")
  (assert-equal t
    "(unless c x)"
    &(fix! "(if c () x)")
    "if-one-branch-empty fix rewrites to unless")
  (assert-equal t "(when c
  (foo
    bar))" &(fix! "(if c
  (foo
    bar)
  ())") "if-one-branch-empty keeps the kept branch's line breaks")
  (assert-equal t "(unless c
  (foo
    bar))" &(fix! "(if c
  ()
  (foo
    bar))") "if-one-branch-empty moves the else branch verbatim")

  (assert-equal t
    "(if c v default)"
    &(fix! "(cond c v default)")
    "cond-single-branch fix rewrites to if")
  (assert-equal t "(if c
  v
  default)" &(fix! "(cond c
  v
  default)") "cond-single-branch keeps the branches where they are")

  (assert-equal t
    "(cond c1 x c2 y z)"
    &(fix! "(if c1 x (if c2 y z))")
    "nested-if-chain fix collapses two levels into a cond")
  (assert-equal t
    "(cond c1 x c2 y c3 z w)"
    &(fix! "(if c1 x (if c2 y (if c3 z w)))")
    "nested-if-chain fix collapses three levels into a cond")
  (assert-equal t
    "(cond c1 x c2 y c3 z c4 a b)"
    &(fix! "(if c1 x (if c2 y (if c3 z (if c4 a b))))")
    "nested-if-chain fix collapses four levels into a cond")
  (assert-equal t "(cond c1
  x
  c2
    y
    z)" &(fix! "(if c1
  x
  (if c2
    y
    z))") "nested-if-chain keeps every branch on the line it was on")
  (assert-equal t
    "(cond c1 x c2 y (do a b))"
    &(fix! "(if c1 x (if c2 y (do a b)))")
    "nested-if-chain moves a do else-branch across verbatim")
  (assert-equal t
    "(cond c1 x c2 y 42)"
    &(fix! "(if c1 x (if c2 y 42))")
    "nested-if-chain accepts a literal else-branch")
  (assert-equal t
    "(cond c1 x c2 y ())"
    &(fix! "(if c1 x (if c2 y ()))")
    "nested-if-chain accepts an empty-list else-branch")
  (assert-equal t
    "(cond c1 %@forms c2 y z)"
    &(fix! "(if c1 %@forms (if c2 y z))")
    "a spliced branch stays inside the enclosing list")
  (assert-equal t
    "(if c (if c2 a b) y)"
    &(fix! "(if c (if c2 a b) y)")
    "a nested if in the then-branch is not rewritten")
  (assert-equal t
    "(cond c1 x c2 (if cb ba bb) z)"
    &(fix! "(if c1 x (if c2 (if cb ba bb) z))")
    "a nested if in a chain's then-branch is carried along untouched")
  (assert-true t
    (has-rule? "(if c1 x (if c2 y))" "nested-if-chain")
    "nested-if-chain still reports a chain whose inner if is malformed")
  (assert-equal t
    "(if c1 x (if c2 y))"
    &(fix! "(if c1 x (if c2 y))")
    "a chain whose inner if has the wrong arity is reported, not fixed")
  (assert-equal t "(if c1 x (if ; hey
  c2 y z))" &(fix! "(if c1 x (if ; hey
  c2 y z))") "a comment before the inner if's condition refuses the rewrite")
  (assert-equal t "(cond c1 x c2 ; hey
  y z)" &(fix! "(if c1 x (if c2 ; hey
  y z))") "a comment inside the inner if is carried into the cond")
  (assert-equal t "(cond c1 ; hey
  x c2 y z)" &(fix! "(if c1 ; hey
  x (if c2 y z))") "a comment inside the outer if is carried into the cond")
  (assert-equal t "(cond c1 x ; hey
  c2 y z)" &(fix! "(if c1 x ; hey
  (if c2 y z))") "a comment before the else-if is carried into the cond")
  (assert-equal t "(cond c1 x c2 y c3 ; hey
  z w)" &(fix! "(if c1 x (if c2 y (if c3 ; hey
  z w)))") "a comment three links down is carried into the cond")
  (assert-equal t "(if c1 x (if c2 y z) ; hey
  )" &(fix! "(if c1 x (if c2 y z) ; hey
  )") "a trailing comment leaves the chain alone")
  (assert-true t (fixed-point? "(if c1 x (if c2 ; hey
  y z))") "fixing a commented chain twice equals fixing it once")
  (assert-true t (parses? &(fix! "(if c1 x (if c2 ; hey
  y z))")) "a rewritten commented chain still parses")
  (assert-equal t 0 (leftover "(if c1 x (if c2 ; hey
  y z))" "nested-if-chain") "a commented chain leaves no finding behind")
  (assert-equal t
    "(cond c1 x c2 y z)"
    &(fix! "(cond c1 x c2 y z)")
    "cond-single-branch does not misfire on a collapsed chain")
  (assert-equal t
    "(cond c1 x c2 y z)"
    &(fix! "(cond c1 x (if c2 y z))")
    "cond-single-branch and nested-if-chain converge instead of flip-flopping")
  (assert-true t
    (fixed-point? "(if c1 x (if c2 y (if c3 z w)))")
    "fixing a nested-if chain twice equals fixing it once")

  (assert-equal t
    "(unless c1 (if c2 y z))"
    &(fix! "(if c1 () (if c2 y z))")
    "two rules that start at one byte resolve to the earlier-registered one")
  (assert-equal t
    "(unless c1 (if c2 y z)) (unless d1 (if d2 p q)) (unless e1 (if e2 r s))"
    &(fix!
      "(if c1 () (if c2 y z)) (if d1 () (if d2 p q)) (if e1 () (if e2 r s))")
    "identically shaped forms in one file all take the same rewrite")
  (assert-equal t
    "x (/= a b) (unless c1 (if c2 y z)) y z"
    &(fix!
      "(do (do x)) (not (= a b)) (if c1 () (if c2 y z)) (do y) (not (not z))")
    "unrelated fixable forms elsewhere do not change a form's rewrite")

  (assert-equal t "()" &(fix! "(do)") "empty-do fix rewrites to unit")

  (assert-equal t
    "(let-do [x 1] a)"
    &(fix! "(let [x 1] (do (do a)))")
    "nested do-forms converge to a single let-do")
  (assert-equal t
    "(when-do c a)"
    &(fix! "(if c (do (do a)) ())")
    "if-with-do converges with the inner lonely-do")
  (assert-equal t
    "(let-do [x 1] (let-do [y 2] a))"
    &(fix! "(let [x 1] (do (let [y 2] (do a))))")
    "an inner form-with-do is fixed along with the outer one")
  (assert-equal t
    "(unless-do c a b)"
    &(fix! "(when (not c) (do a b))")
    "when-with-not and form-with-do compose across passes")
  (assert-equal t
    0
    (leftover
      "(when (not (~f (unsafe-nth a i))) (do (set! res false) (break)))"
      "when-with-not")
    "the all? shape from carp's core is fixed away entirely")
  (assert-equal t
    0
    (leftover
      "(when-do (not (~f (unsafe-nth a i))) (set! res false) (break))"
      "when-with-not")
    "reaching that shape via form-with-do first is not a dead end")
  (assert-true t
    (fixed-point? "(when-do (not c) a b)")
    "fixing a negated when-do twice equals fixing it once")
  (assert-equal t
    "(when-do c a b)"
    &(fix! "(when-do (not (not c)) a b)")
    "a doubly negated -do condition converges across passes")

  (assert-true t
    (fixed-point? "(let [x 1] (do (do a)))")
    "fixing a nested do twice equals fixing it once")
  (assert-true t
    (fixed-point? "(if c (do a b) ())")
    "fixing if-with-do twice equals fixing it once")
  (assert-true t
    (fixed-point? "(if c x ())")
    "fixing if-one-branch-empty twice equals fixing it once")

  (assert-equal t
    "(let [x 1] ())"
    &(fix! "(let [x 1] (do))")
    "an empty do body is not spliced; empty-do rewrites it instead")
  (assert-equal t "(let [x 1] (do ; hi
))" &(fix! "(let [x 1] (do ; hi
))") "a do body of nothing but a comment is not spliced")
  (assert-equal t "(cond ; hi
  c v)" &(fix! "(cond ; hi
  c v)") "a comment among cond's own children refuses the rewrite")
  (assert-equal t "(if c () ; hi
)" &(fix! "(if c () ; hi
)") "a comment in place of a branch refuses the rewrite")
  (assert-equal t
    "(let-do [x 1] %@forms)"
    &(fix! "(let [x 1] (do %@forms))")
    "a spliced unquote-splicing body keeps an enclosing list")

  (assert-true t
    (match (Lint.fix-source "(do")
      (Result.Error _) true
      (Result.Success _) false)
    "fix-source surfaces a parse error")

  (assert-equal t
    "(do x)"
    &(match (Lint.fix-source-with &(fn [n] (/= n "lonely-do")) "(do x)")
      (Result.Success s) s
      (Result.Error _) @"")
    "fix-source-with honours a disabled rule")
  (assert-equal t
    "x"
    &(match (Lint.fix-source-with &(fn [n] (= n "lonely-do")) "(do x)")
      (Result.Success s) s
      (Result.Error _) @"")
    "fix-source-with honours an allow-list")

  (assert-true t (Lint.fixable? "lonely-do") "lonely-do is fixable")
  (assert-true t (Lint.fixable? "form-with-do") "form-with-do is fixable")
  (assert-true t
    (Lint.fixable? "redundant-do-in-do-variant")
    "redundant-do-in-do-variant is fixable")
  (assert-true t (Lint.fixable? "if-with-do") "if-with-do is fixable")
  (assert-true t
    (Lint.fixable? "if-one-branch-empty")
    "if-one-branch-empty is fixable")
  (assert-true t
    (Lint.fixable? "cond-single-branch")
    "cond-single-branch is fixable")
  (assert-true t (Lint.fixable? "empty-do") "empty-do is fixable")
  (assert-true t (Lint.fixable? "nested-if-chain") "nested-if-chain is fixable")
  (assert-false t
    (Lint.fixable? "single-use-let")
    "single-use-let is deliberately not fixable")
  (assert-false t
    (Lint.fixable? "unused-let-binding")
    "unused-let-binding is deliberately not fixable")
  (assert-false t
    (Lint.fixable? "non-kebab-case-defn")
    "non-kebab-case-defn is not fixable")
  (assert-false t
    (Lint.fixable? "identical-if-branches")
    "identical-if-branches is deliberately not fixable")
  (assert-false t
    (Lint.fixable? "eq-self")
    "eq-self is deliberately not fixable")
  (assert-true t
    (Lint.fixable? "if-bool-branches")
    "if-bool-branches is fixable")

  (assert-true t
    (match (Lint.load-rules-from-source!
        "[(identity ?x) \"identity-fix\" \"identity is a no-op\" ?x]")
      (Result.Success n) (Int.= 1 n)
      _ false)
    "loads a rule with a fix template from source")
  (assert-true t
    (has-rule? "(identity 42)" "identity-fix")
    "loaded fixable rule fires")
  (assert-equal t
    "42"
    &(fix! "(identity 42)")
    "loaded fixable rule rewrites via its template")
  (assert-equal t
    43
    (Array.length &(Lint.list-rules))
    "42 previous + 1 loaded with a template = 43")

  (assert-true t
    (match (Lint.load-rules-from-source!
        "[(PRED ?x ?y) \"pred-template\" \"names a predicate\" (unless (empty? ?x) ?y)]
[(BAREQ ?x) \"bare-q\" \"ends in a bare ?\" (huh ?x ?)]
[(ONLYQ ?x) \"only-q\" \"is a bare ?\" ?]
[(QEND ?x) \"q-end\" \"is a lone predicate name\" empty?]
[(QAM ?x) \"q-after-meta\" \"is a metavariable then a ?\" (f ?x?)]
[(QSTR ?x) \"q-in-string\" \"has a ? inside a string\" (IO.println \"huh?\" ?x)]
[(UNB ?x) \"unbound-meta\" \"names an unbound metavariable\" (f ?y)]")
      (Result.Success n) (Int.= 7 n)
      _ false)
    "loads rules whose templates hold a ? outside a metavariable")
  (assert-equal t
    "(unless (empty? a) b)"
    &(fix! "(PRED a b)")
    "a ? inside a symbol name is literal template text")
  (assert-equal t
    "(huh a ?)"
    &(fix! "(BAREQ a)")
    "a bare ? in a template is literal text")
  (assert-equal t "?" &(fix! "(ONLYQ a)") "a template of nothing but ? expands")
  (assert-equal t
    "empty?"
    &(fix! "(QEND a)")
    "a ? as the last byte of a template is literal text")
  (assert-equal t
    "(f a?)"
    &(fix! "(QAM a)")
    "a ? right after a metavariable is literal text")
  (assert-equal t
    "(IO.println \"huh?\" a)"
    &(fix! "(QSTR a)")
    "a ? inside a string literal is literal text")
  (assert-equal t
    "(UNB a)"
    &(fix! "(UNB a)")
    "a template naming an unbound metavariable still refuses to rewrite")

  (assert-true t
    (match (Lint.load-rules-from-source!
        "[(STARQ ?*) \"star-pattern\" \"holds a ? without a name character\" (G ?*)]
[(NAMEQ ?x) \"name-pattern\" \"holds an ordinary metavariable\" (G ?x)]")
      (Result.Success n) (Int.= 2 n)
      _ false)
    "loads rules whose patterns hold a ? outside a metavariable")
  (assert-false t
    (has-rule? "(STARQ 123)" "star-pattern")
    "a ? without a name character after it does not bind in a pattern")
  (assert-equal t
    "(STARQ 123)"
    &(fix! "(STARQ 123)")
    "a pattern that cannot bind leaves the source alone")
  (assert-equal t
    "(G ?*)"
    &(fix! "(STARQ ?*)")
    "a ? without a name character matches literally on both sides")
  (assert-equal t
    "(G 123)"
    &(fix! "(NAMEQ 123)")
    "an ordinary metavariable still binds and expands")

  (assert-true t
    (match (Lint.load-rules-from-source!
        "[(INNERQ ?x ?x?) \"inner-q-pattern\" \"holds a ? after a name character\" (G ?x?)]
[(INNERSTAR ?y ?y*) \"inner-star-pattern\" \"holds a * after a name character\" (G ?y*)]")
      (Result.Success n) (Int.= 2 n)
      _ false)
    "loads rules whose patterns hold a ?name ending in a non-name character")
  (assert-false t
    (has-rule? "(INNERQ 11 22)" "inner-q-pattern")
    "a ? after the name characters does not bind in a pattern")
  (assert-false t
    (has-rule? "(INNERSTAR 11 22)" "inner-star-pattern")
    "a non-name character after the name characters does not bind in a pattern")
  (assert-equal t
    "(INNERQ 11 22)"
    &(fix! "(INNERQ 11 22)")
    "a pattern whose ?name ends in a ? leaves the source alone")
  (assert-equal t
    "(INNERSTAR 11 22)"
    &(fix! "(INNERSTAR 11 22)")
    "a pattern whose ?name ends in a * leaves the source alone")

  (assert-true t
    (match (Lint.load-rules-from-source!
        "[(?a ?b) \"swap-pair\" \"swap the operands\" (?b ?a)]")
      (Result.Success n) (Int.= 1 n)
      _ false)
    "loads a rule whose template can bind a synthesized node")
  (assert-equal t
    "@x"
    &(fix! "@x")
    "a metavariable bound to a synthesized node is not fixed")

  (assert-false t
    (has-rule? "'(do x)" "lonely-do")
    "a quoted form is data and is not reported")
  (assert-false t
    (has-rule? "(quote (do x))" "lonely-do")
    "a hand-written quote is the same node as a reader quote")
  (assert-false t
    (has-rule? "'(defn FooBar [] 1)" "non-kebab-case-defn")
    "a quoted defn is data and is not reported")
  (assert-false t
    (has-rule? "'(let [x 1] 2)" "unused-let-binding")
    "a quoted let is data and is not reported")
  (assert-false t
    (has-rule? "'(a (b (do x)))" "lonely-do")
    "a quote hides every depth below it")
  (assert-false t
    (has-rule? "'(do %x)" "lonely-do")
    "an unquote under a plain quote does not restore code")
  (assert-true t
    (has-rule? "(do 'x)" "lonely-do")
    "the form holding the quote is still code")
  (assert-equal t
    "(defn f [] '(if c true false))"
    &(fix! "(defn f [] '(if c true false))")
    "a quoted if is not rewritten")
  (assert-equal t
    "(defn f [] '(= x true))"
    &(fix! "(defn f [] '(= x true))")
    "a quoted comparison is not rewritten")
  (assert-equal t
    "(defn f [] '(when (not c) (do a b)))"
    &(fix! "(defn f [] '(when (not c) (do a b)))")
    "a quoted when is not rewritten")
  (assert-equal t
    "(defn f [] (quote (do x)))"
    &(fix! "(defn f [] (quote (do x)))")
    "a hand-written quote is not rewritten either")

  (assert-true t
    (has-rule? "`(do x)" "lonely-do")
    "a quasiquoted form is a template and is still reported")
  (assert-equal t
    "`(do x)"
    &(fix! "`(do x)")
    "a quasiquoted form is not rewritten")
  (assert-equal t
    "`(do %@forms)"
    &(fix! "`(do %@forms)")
    "a spliced quasiquote body of unknown arity is not rewritten")
  (assert-true t
    (has-rule? "`(a '(do x))" "lonely-do")
    "a quasiquote substitutes through a nested quote, so it stays a template")
  (assert-equal t
    "`(a '(do x))"
    &(fix! "`(a '(do x))")
    "a quote inside a quasiquote is not rewritten")
  (assert-equal t
    "`(a '(do %x))"
    &(fix! "`(a '(do %x))")
    "an unquote under a quote inside a quasiquote still expands, so it stands")

  (assert-true t
    (has-rule? "`(a %(do x))" "lonely-do")
    "an unquoted argument is code again")
  (assert-equal t
    "`(a %x)"
    &(fix! "`(a %(do x))")
    "an unquoted argument is rewritten")
  (assert-equal t
    "`(a %@x)"
    &(fix! "`(a %@(do x))")
    "a splice's argument is rewritten")
  (assert-equal t
    "``(a %%x)"
    &(fix! "``(a %%(do x))")
    "an unquote returns one quasiquote level at a time")
  (assert-equal t
    "``(a %(do x))"
    &(fix! "``(a %(do x))")
    "one unquote inside two quasiquotes is still a template")

  (assert-true t
    (fixed-point? "(defn f [] '(if c true false))")
    "quoted data is a fixpoint")
  (assert-true t
    (fixed-point? "`(a %(do (do x)))")
    "an unquoted argument still converges"))
